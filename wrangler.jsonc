{
  // Static-assets Worker for the Astro build output.
  //
  // Committed so that non-production branch builds work: Cloudflare applies the
  // dashboard build settings only to the production branch, so preview builds on
  // other branches need this config in the repo.
  //
  // "main" points at a hand-written Worker entry, NOT at an Astro SSR build.
  // Astro still builds this site statically (no adapter in astro.config.mjs), so
  // no dist/_worker.js is produced and the config Cloudflare auto-generated on
  // the cloudflare/workers-autoconfig branch — which points main at
  // dist/_worker.js/index.js — would still be wrong.
  //
  // worker/index.ts serves one dynamic route, the MCP server at /mcp, and hands
  // everything else to the assets binding. Requests matching a static asset are
  // served by the asset layer without invoking the Worker, since run_worker_first
  // is not set.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "personalwebsite",
  "compatibility_date": "2026-06-12",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },

  // Staging: deployed from the `staging` branch to staging.mikeshoss.com, as a
  // separate Worker. `run_worker_first` sends every request through the Worker
  // (instead of letting the asset layer short-circuit it) so worker/index.ts
  // can demand a password before serving anything. The password itself is the
  // STAGING_PASSWORD secret, set only on this Worker:
  //   wrangler secret put STAGING_PASSWORD --env staging
  "env": {
    "staging": {
      "name": "personalwebsite-staging",
      "routes": [{ "pattern": "staging.mikeshoss.com", "custom_domain": true }],
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
