---
import Layout from '../layouts/Layout.astro';
import { companies } from '../data/content';
---

<Layout
  title="Companies — Mike Shoss"
  description="The companies Mike Shoss has founded: Epilogue, ShossX, and Milton Innovation."
>
  <section class="section-container pt-28">
    <h1 class="section-title">Companies</h1>
    <p class="section-subtitle">The companies I run and the products we're building.</p>

    <div class="space-y-12">
      {companies.map(company => (
        <article class="card">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
            <div>
              <h2 class="text-2xl font-bold">
                {company.url ? (
                  <a href={company.url} target="_blank" rel="noopener noreferrer" class="link-hover">
                    {company.name} <span class="text-sm">&#8599;</span>
                  </a>
                ) : (
                  company.name
                )}
              </h2>
              <p class="text-sm text-muted mt-1">{company.role}</p>
            </div>
            <span class="text-sm text-muted font-mono whitespace-nowrap">{company.period}</span>
          </div>

          <p class="text-gray-400 leading-relaxed mb-6">{company.description}</p>

          {company.products && company.products.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-muted uppercase tracking-wider mb-4">Products</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {company.products.map(product => (
                  <div class="bg-surface-50 border border-surface-200 rounded-lg p-4">
                    <div class="flex items-start justify-between mb-2">
                      <h4 class="font-semibold text-white">{product.name}</h4>
                      <span class="text-xs font-mono text-accent bg-accent/10 px-2 py-0.5 rounded-full whitespace-nowrap">
                        {product.status}
                      </span>
                    </div>
                    <p class="text-xs text-accent font-mono mb-2">{product.tagline}</p>
                    <p class="text-sm text-muted leading-relaxed">{product.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>
