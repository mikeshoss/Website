---
import Layout from '../layouts/Layout.astro';
import { projects, site, companies } from '../data/content';
import { placement, withCampaign } from '../lib/links';
import { byAssociation, splitByStatus } from '../lib/projects';

/**
 * This page is the personal work only. Epilogue's projects stay in content.ts
 * — the venture page, its syndication feed, the JSON API and the MCP server
 * all still read them — but they are not listed here. The studio has its own
 * site, and that is where its work should be seen.
 *
 * Anything with an association that is neither Personal nor a known venture
 * lands in a trailing "Unassigned" group rather than disappearing, which is
 * what makes a typo in `association` visible instead of silent.
 */
const personal = splitByStatus(byAssociation(projects, 'Personal'));

const ventureNames = new Set(companies.map(c => c.name));
const orphans = projects.filter(p => p.association !== 'Personal' && !ventureNames.has(p.association ?? ''));

const epilogue = companies.find(c => c.slug === 'epilogue');
const epilogueProducts = epilogue?.products?.map(p => p.name) ?? [];
const epilogueUrl = withCampaign(epilogue?.url, 'projects-page');

const listed = [...personal.active, ...personal.past, ...orphans];
---

<Layout
  title="Projects — Mike Shoss"
  description="AI systems, MCP servers, radio and infrastructure projects Mike Shoss builds on his own time."
  breadcrumbs={[{ name: 'Projects', href: '/projects' }]}
  schema={[
    {
      '@type': 'ItemList',
      '@id': `${site.url}/projects/#projects`,
      name: 'Projects by Mike Shoss',
      numberOfItems: listed.length,
      itemListElement: listed.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: project.name,
          description: project.description,
          ...(project.url || project.repo ? { url: project.url ?? project.repo } : {}),
          ...(project.repo ? { codeRepository: project.repo } : {}),
        },
      })),
    },
  ]}
>
  <section class="page pt-20 md:pt-28 pb-12 md:pb-16">
    <h1 class="display text-display-xl max-w-[18ch]">Built for myself, in the open.</h1>
    <p class="lede mt-8 max-w-prose">
      Radio, aircraft, transit, civic records, and a lot of MCP servers. Most of these exist
      because I wanted the thing and it didn't exist yet. Source is linked wherever the repo is public.
    </p>
  </section>

  <!-- ============================================================ Active -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">Active <b>{personal.active.length}</b></p>
    <div class="mt-8 grid md:grid-cols-2 gap-px bg-line border border-line">
      {personal.active.map(project => (
        <article class="bg-ink p-7 md:p-8 flex flex-col">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="display text-display-sm">{project.name}</h2>
            <span class="text-xs font-mono text-muted whitespace-nowrap">{project.start.slice(0, 4)}</span>
          </div>
          <p class="text-sm text-bone-dim leading-relaxed mt-4">{project.description}</p>
          {(project.url || project.repo) && (
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-auto pt-6">
              {project.url && (
                <a href={withCampaign(project.url, placement('project', project.name))} target="_blank" rel="noopener noreferrer" class="arrow-link text-xs">Site ↗</a>
              )}
              {project.repo && (
                <a href={project.repo} target="_blank" rel="noopener noreferrer" class="arrow-link text-xs">Source ↗</a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ============================================================ Epilogue -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">Epilogue</p>
    <div class="mt-8 flex flex-col md:flex-row md:items-baseline md:justify-between gap-6">
      <div>
        <h2 class="display text-display-md max-w-[22ch]">The work we do at Epilogue lives on its own site.</h2>
        {epilogueProducts.length > 0 && (
          <p class="text-sm text-muted mt-3 max-w-prose leading-relaxed">{epilogueProducts.join(', ')}.</p>
        )}
      </div>
      {epilogueUrl && (
        <a href={epilogueUrl} target="_blank" rel="noopener noreferrer" class="btn-primary whitespace-nowrap">See what we're building</a>
      )}
    </div>
  </section>

  <!-- ============================================================ Past -->
  {personal.past.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">Past <b>{personal.past.length}</b></p>
      <ol class="mt-8 ruled">
        {personal.past.map(project => (
          <li class="py-6 grid md:grid-cols-12 gap-x-8 gap-y-2">
            <div class="md:col-span-3">
              <p class="display text-2xl leading-tight">{project.name}</p>
              <p class="text-xs font-mono text-muted mt-1.5">{project.period}</p>
            </div>
            <div class="md:col-span-7">
              <p class="text-sm text-muted leading-relaxed">{project.description}</p>
              {(project.url || project.repo) && (
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-3">
                  {project.url && (
                    <a href={withCampaign(project.url, placement('project', project.name))} target="_blank" rel="noopener noreferrer" class="arrow-link text-xs">Site ↗</a>
                  )}
                  {project.repo && (
                    <a href={project.repo} target="_blank" rel="noopener noreferrer" class="arrow-link text-xs">Source ↗</a>
                  )}
                </div>
              )}
            </div>
            <div class="md:col-span-2 md:text-right">
              <span class="chip">{project.status}</span>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {orphans.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">Unassigned</p>
      <ol class="mt-8 ruled">
        {orphans.map(project => (
          <li class="py-6">
            <p class="display text-2xl">{project.name}</p>
            <p class="text-xs font-mono text-muted mt-1">association: {project.association ?? '(none)'}</p>
          </li>
        ))}
      </ol>
    </section>
  )}
</Layout>
