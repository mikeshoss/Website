---
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import { experience, patents, volunteering, education, certifications, interests, grantedPatentCount, yearsExperience } from '../data/content';

/**
 * Consecutive roles at the same company collapse under one company heading,
 * so Firework's three titles read as one tenure rather than three entries.
 * Non-consecutive returns (none today) would stay separate, which is right.
 */
type Role = (typeof experience)[number];
const tenures: { company: string; url?: string; location?: string; roles: Role[] }[] = [];
for (const role of experience) {
  const last = tenures[tenures.length - 1];
  if (last && last.company === role.company) {
    last.roles.push(role);
  } else {
    tenures.push({ company: role.company, url: role.url, location: role.location, roles: [role] });
  }
}

const tenureYears = (t: (typeof tenures)[number]) => {
  const first = t.roles[t.roles.length - 1];
  const latest = t.roles[0];
  const start = first.start.slice(0, 4);
  const end = latest.end ? latest.end.slice(0, 4) : 'Now';
  return start === end ? start : `${start}–${end}`;
};

const groups: { key: string; label: string; roles: typeof volunteering }[] = [
  { key: 'mentoring', label: 'Mentoring', roles: volunteering.filter(v => v.category === 'mentoring') },
  { key: 'governance', label: 'Board & governance', roles: volunteering.filter(v => v.category === 'governance') },
  { key: 'advisory', label: 'Advisory & expert networks', roles: volunteering.filter(v => v.category === 'advisory') },
  { key: 'community', label: 'Community', roles: volunteering.filter(v => v.category === 'community') },
].filter(g => g.roles.length > 0);

// Tabs. `count` shows in the tab label; the panel id doubles as the URL hash,
// so /experience#patents opens straight to the patents.
const tabs = [
  { id: 'career', label: 'Career', count: tenures.length },
  { id: 'patents', label: 'Patents', count: patents.length },
  { id: 'community', label: 'Community', count: volunteering.length },
  { id: 'education', label: 'Education' },
  { id: 'outside', label: 'Outside work' },
];
---

<Layout
  title="Experience — Mike Shoss"
  description="Career history, patents, education, and volunteering work by Mike Shoss."
  breadcrumbs={[{ name: 'Experience', href: '/experience' }]}
>
  <section class="page pt-20 md:pt-28 pb-10">
    <h1 class="display text-display-xl max-w-[18ch]">{yearsExperience}+ years of shipping.</h1>
    <p class="lede mt-8 max-w-prose">
      Developer first, then product. The through-line is taking a persistent, expensive workflow
      and turning it into something people use every week.
    </p>
  </section>

  <!-- Tab bar. Sticky under the site header so it stays reachable on the long panels. -->
  <div class="sticky top-16 z-40 bg-ink/85 backdrop-blur-md border-b border-line">
    <div class="page overflow-x-auto">
      <div role="tablist" aria-label="Experience sections" class="flex gap-7 md:gap-9" data-tabs>
        {tabs.map((tab, i) => (
          <button
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="tab"
            data-tab={tab.id}
          >
            {tab.label}{tab.count !== undefined && <span class="count">{tab.count}</span>}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- ============================================================ Career -->
  <section id="panel-career" role="tabpanel" aria-labelledby="tab-career" tabindex="0" class="section" data-panel>
    <ol class="ruled">
      {tenures.map(t => (
        <li class="py-8 md:py-10 grid md:grid-cols-12 gap-x-8 gap-y-4">
          <div class="md:col-span-3">
            <p class="display text-display-sm leading-tight">
              {t.url
                ? <a href={t.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{t.company} <span class="text-muted text-lg">↗</span></a>
                : t.company}
            </p>
            <p class="text-xs font-mono text-muted mt-2">{tenureYears(t)}</p>
            {t.location && <p class="text-xs text-muted mt-1">{t.location}</p>}
          </div>
          <div class="md:col-span-9 space-y-8">
            {t.roles.map(role => (
              <div>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <h2 class="font-medium text-bone">{role.title}</h2>
                  <span class="text-xs font-mono text-muted whitespace-nowrap">{role.period}</span>
                </div>
                {role.highlights.length > 0 && (
                  <ul class="mt-3 space-y-2">
                    {role.highlights.map(h => (
                      <li class="text-sm text-muted leading-relaxed pl-4 relative before:content-[''] before:absolute before:left-0 before:top-[0.7em] before:w-1.5 before:h-px before:bg-accent">{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================================================ Patents -->
  <section id="panel-patents" role="tabpanel" aria-labelledby="tab-patents" tabindex="0" class="section" data-panel hidden>
    <div class="grid md:grid-cols-12 gap-8 mb-10">
      <h2 class="display text-display-md md:col-span-5">{patents.length} patents, {grantedPatentCount} granted.</h2>
      <p class="prose-body md:col-span-6 md:col-start-7 text-sm">
        All filed with Loop Now Technologies (Firework), covering livestream commerce, short-form
        video and an LLM-assisted livestream. Numbers ending in B2 are granted; A1 are
        pre-grant publications.
      </p>
    </div>
    <ol class="ruled">
      {patents.map(patent => {
        const Tag = patent.url ? 'a' : 'div';
        const props = patent.url ? { href: patent.url, target: '_blank', rel: 'noopener noreferrer' } : {};
        return (
          <li>
            <Tag {...props} class:list={['py-5 grid md:grid-cols-12 gap-x-8 gap-y-2 transition-colors duration-200', patent.url && 'group hover:bg-ink-50 -mx-4 px-4']}>
              <p class="md:col-span-7 text-bone leading-snug group-hover:text-accent transition-colors duration-200">
                {patent.title}{patent.url && <span class="text-muted"> ↗</span>}
              </p>
              <p class="md:col-span-3 text-xs font-mono text-muted">{patent.number}</p>
              <p class="md:col-span-2 md:text-right text-xs font-mono">
                {patent.status === 'Granted'
                  ? <span class="text-accent">Granted {patent.grantedLabel}</span>
                  : <span class="text-muted">Filed {patent.filedLabel}</span>}
              </p>
            </Tag>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- ============================================================ Community -->
  <section id="panel-community" role="tabpanel" aria-labelledby="tab-community" tabindex="0" class="section" data-panel hidden>
    <div class="space-y-14">
      {groups.map(group => (
        <div>
          <div class="rule pt-5 mb-6">
            <p class="eyebrow">{group.label} <b>{group.roles.length}</b></p>
          </div>
          <div class="grid md:grid-cols-2 gap-px bg-line border border-line">
            {group.roles.map(role => <RoleCard role={role} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================ Education -->
  <section id="panel-education" role="tabpanel" aria-labelledby="tab-education" tabindex="0" class="section" data-panel hidden>
    <div class="rule pt-5 mb-6"><p class="eyebrow">Education</p></div>
    <ol class="ruled">
      {education.map(item => (
        <li class="py-6 grid md:grid-cols-12 gap-x-8 gap-y-1">
          <p class="md:col-span-4 display text-2xl leading-tight">{item.institution}</p>
          <div class="md:col-span-6">
            <p class="text-bone">{item.credential}</p>
            {item.detail && <p class="text-sm text-muted mt-1.5">{item.detail}</p>}
          </div>
          <p class="md:col-span-2 md:text-right text-xs font-mono text-muted">{item.period}</p>
        </li>
      ))}
    </ol>

    <div class="rule pt-5 mt-14 mb-6"><p class="eyebrow">Certifications</p></div>
    <ul class="flex flex-wrap gap-2">
      {certifications.map(cert => <li class="chip normal-case tracking-normal text-xs text-bone-dim">{cert.name}</li>)}
    </ul>
  </section>

  <!-- ============================================================ Outside work -->
  <section id="panel-outside" role="tabpanel" aria-labelledby="tab-outside" tabindex="0" class="section" data-panel hidden>
    <div class="grid md:grid-cols-3 gap-px bg-line border border-line">
      {interests.map(interest => (
        <div class="bg-ink p-7">
          <h2 class="display text-display-sm">{interest.name}</h2>
          {interest.keywords && (
            <ul class="mt-5 space-y-1.5">
              {interest.keywords.map(k => <li class="text-xs font-mono text-muted">{k}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  /**
   * Tabs. Progressive: without JS every panel renders stacked (the `hidden`
   * attributes are removed below and re-applied per selection), and the
   * selected tab is kept in the URL hash so a link to #patents works and the
   * back button returns to the previous tab.
   */
  const list = document.querySelector<HTMLElement>('[data-tabs]');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  if (list && tabs.length) {
    const ids = tabs.map(t => t.dataset.tab!);

    const select = (id: string, { focus = false, push = true } = {}) => {
      if (!ids.includes(id)) id = ids[0];
      tabs.forEach(tab => {
        const on = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach(panel => { panel.hidden = panel.id !== `panel-${id}`; });
      if (push) history.replaceState(null, '', id === ids[0] ? location.pathname : `#${id}`);
    };

    tabs.forEach(tab => tab.addEventListener('click', () => select(tab.dataset.tab!)));

    list.addEventListener('keydown', (e: KeyboardEvent) => {
      const i = ids.indexOf((document.activeElement as HTMLElement)?.dataset.tab ?? '');
      if (i < 0) return;
      const moves: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: ids.length - 1 };
      const next = moves[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select(ids[(next + ids.length) % ids.length], { focus: true });
    });

    window.addEventListener('hashchange', () => select(location.hash.slice(1), { push: false }));
    select(location.hash.slice(1), { push: false });
  } else {
    panels.forEach(p => { p.hidden = false; });
  }
</script>

<noscript>
  <style>
    [data-panel][hidden] { display: block; }
    [data-tabs] { display: none; }
  </style>
</noscript>
