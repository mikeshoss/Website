---
import Layout from '../layouts/Layout.astro';
import { experience, patents, volunteering, education, certifications } from '../data/content';

const mentoringRoles = volunteering.filter(v => v.category === 'mentoring');
const advisoryRoles = volunteering.filter(v => v.category === 'advisory');
const communityRoles = volunteering.filter(v => v.category === 'community');
const governanceRoles = volunteering.filter(v => v.category === 'governance');
---

<Layout
  title="Experience — Mike Shoss"
  description="Career history, patents, education, and volunteering work by Mike Shoss."
>
  <section class="section-container pt-28">
    <h1 class="section-title">Experience</h1>
    <p class="section-subtitle">Career, patents, education, and community involvement.</p>

    <!-- Career Timeline -->
    <div class="mb-20">
      <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-8">Career</h2>
      <div class="space-y-1">
        {experience.map((role, i) => (
          <div class="relative pl-8 pb-8 border-l border-surface-200 last:border-l-transparent last:pb-0">
            <div class="absolute left-0 top-1 w-2 h-2 rounded-full bg-accent -translate-x-[4.5px]"></div>
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-2">
              <div>
                <h3 class="font-semibold text-white">{role.title}</h3>
                {role.url ? (
                  <a href={role.url} target="_blank" rel="noopener noreferrer" class="text-sm text-accent hover:text-accent/70 transition-colors">{role.company} ↗</a>
                ) : (
                  <p class="text-sm text-accent">{role.company}</p>
                )}
              </div>
              <span class="text-xs text-muted font-mono whitespace-nowrap">{role.period}</span>
            </div>
            {role.location && (
              <p class="text-xs text-muted mb-2">{role.location}</p>
            )}
            {role.highlights.length > 0 && (
              <ul class="list-disc list-outside pl-5 space-y-1 mt-2 marker:text-muted">
                {role.highlights.map(h => (
                  <li class="text-sm text-gray-400">{h}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Patents -->
    <div class="mb-20">
      <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-8">Patents ({patents.length})</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {patents.map(patent => (
          patent.url ? (
            <a href={patent.url} target="_blank" rel="noopener noreferrer" class="card block group">
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3 class="font-medium text-white text-sm leading-snug">{patent.title}</h3>
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent flex-shrink-0 mt-0.5 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <div class="flex items-center flex-wrap gap-x-4 gap-y-1 text-xs text-muted font-mono">
                <span>{patent.number}</span>
                <span>Filed {patent.filed}</span>
                {patent.status === 'Granted' && (
                  <span class="text-accent">Granted {patent.granted}</span>
                )}
              </div>
            </a>
          ) : (
            <div class="card">
              <h3 class="font-medium text-white text-sm leading-snug mb-2">{patent.title}</h3>
              <div class="flex items-center flex-wrap gap-x-4 gap-y-1 text-xs text-muted font-mono">
                <span>{patent.number}</span>
                <span>Filed {patent.filed}</span>
                {patent.status === 'Granted' && (
                  <span class="text-accent">Granted {patent.granted}</span>
                )}
              </div>
            </div>
          )
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="mb-20">
      <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-8">Education</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {education.map(item => (
          <div class="card">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-1">
              <h3 class="font-semibold text-white text-sm">{item.institution}</h3>
              {item.period && (
                <span class="text-xs text-muted font-mono whitespace-nowrap">{item.period}</span>
              )}
            </div>
            <p class="text-sm text-accent">{item.credential}</p>
            {item.detail && (
              <p class="text-sm text-gray-400 mt-2">{item.detail}</p>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Certifications -->
    <div class="mb-20">
      <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-8">Certifications</h2>
      <div class="flex flex-wrap gap-3">
        {certifications.map(cert => (
          <span class="pill">{cert.name}</span>
        ))}
      </div>
    </div>

    <!-- Volunteering -->
    <div>
      <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-8">Volunteering & Community</h2>

      <!-- Mentoring -->
      {mentoringRoles.length > 0 && (
        <div class="mb-10">
          <h3 class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Mentoring</h3>
          <div class="space-y-4">
            {mentoringRoles.map(role => (
              role.url ? (
                <a href={role.url} target="_blank" rel="noopener noreferrer" class="card block group">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-1">
                    <div>
                      <div class="flex items-center gap-2">
                        <h4 class="font-medium text-white text-sm group-hover:text-accent transition-colors">{role.title}</h4>
                        <svg class="w-3 h-3 text-muted group-hover:text-accent flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </div>
                      <p class="text-sm text-accent">{role.organization}</p>
                    </div>
                    <span class="text-xs text-muted font-mono whitespace-nowrap">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </a>
              ) : (
                <div class="card">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-1">
                    <div>
                      <h4 class="font-medium text-white text-sm">{role.title}</h4>
                      <p class="text-sm text-accent">{role.organization}</p>
                    </div>
                    <span class="text-xs text-muted font-mono whitespace-nowrap">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </div>
              )
            ))}
          </div>
        </div>
      )}

      <!-- Governance -->
      {governanceRoles.length > 0 && (
        <div class="mb-10">
          <h3 class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Board & Governance</h3>
          <div class="space-y-4">
            {governanceRoles.map(role => (
              role.url ? (
                <a href={role.url} target="_blank" rel="noopener noreferrer" class="card block group">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-1">
                    <div>
                      <div class="flex items-center gap-2">
                        <h4 class="font-medium text-white text-sm group-hover:text-accent transition-colors">{role.title}</h4>
                        <svg class="w-3 h-3 text-muted group-hover:text-accent flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </div>
                      <p class="text-sm text-accent">{role.organization}</p>
                    </div>
                    <span class="text-xs text-muted font-mono whitespace-nowrap">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </a>
              ) : (
                <div class="card">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-1">
                    <div>
                      <h4 class="font-medium text-white text-sm">{role.title}</h4>
                      <p class="text-sm text-accent">{role.organization}</p>
                    </div>
                    <span class="text-xs text-muted font-mono whitespace-nowrap">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </div>
              )
            ))}
          </div>
        </div>
      )}

      <!-- Advisory -->
      {advisoryRoles.length > 0 && (
        <div class="mb-10">
          <h3 class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Advisory & Expert Networks</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {advisoryRoles.map(role => (
              role.url ? (
                <a href={role.url} target="_blank" rel="noopener noreferrer" class="card block group">
                  <div class="flex flex-col sm:flex-start gap-1 mb-1">
                    <div class="flex items-center gap-2">
                      <h4 class="font-medium text-white text-sm group-hover:text-accent transition-colors">{role.title}</h4>
                      <svg class="w-3 h-3 text-muted group-hover:text-accent flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </div>
                    <p class="text-sm text-accent">{role.organization}</p>
                    <span class="text-xs text-muted font-mono">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </a>
              ) : (
                <div class="card">
                  <div class="flex flex-col sm:flex-start gap-1 mb-1">
                    <h4 class="font-medium text-white text-sm">{role.title}</h4>
                    <p class="text-sm text-accent">{role.organization}</p>
                    <span class="text-xs text-muted font-mono">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </div>
              )
            ))}
          </div>
        </div>
      )}

      <!-- Community -->
      {communityRoles.length > 0 && (
        <div class="mb-10">
          <h3 class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Community</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {communityRoles.map(role => (
              role.url ? (
                <a href={role.url} target="_blank" rel="noopener noreferrer" class="card block group">
                  <div class="flex flex-col sm:flex-start gap-1 mb-1">
                    <div class="flex items-center gap-2">
                      <h4 class="font-medium text-white text-sm group-hover:text-accent transition-colors">{role.title}</h4>
                      <svg class="w-3 h-3 text-muted group-hover:text-accent flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </div>
                    <p class="text-sm text-accent">{role.organization}</p>
                    <span class="text-xs text-muted font-mono">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </a>
              ) : (
                <div class="card">
                  <div class="flex flex-col sm:flex-start gap-1 mb-1">
                    <h4 class="font-medium text-white text-sm">{role.title}</h4>
                    <p class="text-sm text-accent">{role.organization}</p>
                    <span class="text-xs text-muted font-mono">{role.period}</span>
                  </div>
                  <p class="text-sm text-gray-400 mt-2">{role.description}</p>
                </div>
              )
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
