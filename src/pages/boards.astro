---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/content';

/**
 * Board profile, for nominations committees, board chairs and search firms.
 * A calmer register than the rest of the site: no record-label language.
 *
 * Accuracy rules (Mike, 2026-11-10): only the facts he supplied. Board seats
 * and advisory roles are kept apart: only MCRC and PSCC 910 are board seats;
 * DMZ and The Forge are advisory and never go under "Board experience".
 * Items marked as placeholders stay visibly marked until he fills them in.
 */
const email = 'mike.shoss@gmail.com';
const resume = '/files/mike-shoss-board-resume.pdf';

const strengths = [
  {
    title: 'Capital projects and financial oversight',
    detail: 'As a condominium Treasurer, I oversaw a reserve-funded parking garage rebuild and a $2 million operating budget.',
  },
  {
    title: 'Fundraising and community',
    detail: "I built the plan, goals and budget for a nonprofit fundraising campaign. I cultivate donors and open doors across Milton and Halton.",
  },
  {
    title: 'Technology and AI governance',
    detail: "I've set company-wide AI strategy and governance with executive leadership, and implemented an AI management system aligned with ISO/IEC 42001.",
  },
  {
    title: 'Accessibility',
    detail: "I've led AODA and WCAG compliance work at several companies.",
  },
  {
    title: 'Change management',
    detail: "I've led product organizations through rapid growth. That included taking a 60-person team through a US$150 million Series B.",
  },
];

const advisory = [
  {
    org: 'DMZ',
    role: 'Expert-in-Residence, Artificial Intelligence',
    dates: { from: 'Jan 2025', fromIso: '2025-01' },
    detail: 'I advise startup founders on AI systems and strategy.',
  },
  {
    org: 'The Forge, McMaster University',
    role: 'Lead Mentor',
    dates: { from: 'Jan 2024', fromIso: '2024-01' },
    detail: "I mentor early-stage founders. Portfolio companies have raised more than $20 million.",
  },
];

const community = [
  'Founder of Milton Innovation, a community that has brought together technology people from across Halton.',
  "Animal welfare: I'm a donor to Happy's Place (a senior dog rescue), Yamnuska Wolfdog Sanctuary and OVC Pet Trust.",
  "For more than fifteen years, I've asked family and friends to donate to charity instead of buying me gifts, including SickKids and local charities.",
  'I organize a trading-card giveaway for kids in Milton.',
  'Member of the Milton Chamber of Commerce, through Epilogue.',
];

const affiliations = [
  { name: 'Clio', what: 'Staff Product Manager (my employer)' },
  { name: 'Epilogue', what: 'Founder & Principal, an AI consulting and product studio' },
  { name: 'CedarPeak Ventures', what: 'angel investing' },
  { name: 'Of Record Media', what: 'an Epilogue venture that publishes Ontario municipal council decisions from public records' },
];

const personId = `${site.url}/#person`;
---

<Layout
  card="boards"
  title="Mike Shoss — Board Director"
  description="Mike Shoss is a board director and technology executive in Milton, Ontario: Treasurer experience with budgets and capital projects, nonprofit fundraising, and AI governance in regulated industries."
  breadcrumbs={[{ name: 'Boards', href: '/boards' }]}
  schema={[
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Board Director',
        occupationLocation: { '@type': 'City', name: 'Milton, Ontario' },
      },
      memberOf: [
        {
          '@type': 'OrganizationRole',
          roleName: 'Director; Chair, Business Development Committee',
          memberOf: { '@type': 'NGO', name: 'Milton Community Resource Centre' },
        },
        {
          '@type': 'OrganizationRole',
          roleName: 'Director and Treasurer',
          startDate: '2015-04',
          endDate: '2019-07',
          memberOf: { '@type': 'Organization', name: 'Peel Standard Condominium Corporation 910' },
        },
      ],
    },
  ]}
>
  <!-- 1. Intro -->
  <section class="page pt-14 md:pt-20 pb-12 md:pb-16" aria-labelledby="boards-title">
    <p class="eyebrow">Board profile · <b>Milton, Ontario</b></p>
    <h1 id="boards-title" class="display text-display-lg md:text-display-xl mt-10 max-w-[18ch]">Mike Shoss, Board Director</h1>
    <div class="mt-8 max-w-prose space-y-4 text-lg text-bone-dim leading-relaxed">
      <p>I'm a board director and technology executive based in Milton, Ontario.</p>
      <p>
        As a Treasurer, I've worked through budgets and building projects, and I've done the hands-on side of
        fundraising. My career has been about guiding software companies through growth and change, including AI
        strategy and governance in regulated industries.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={resume} class="btn-primary" type="application/pdf">Download board resume (PDF)</a>
      <a href={`mailto:${email}`} class="btn-quiet">Email me<span class="sr-only"> at {email}</span></a>
    </div>
  </section>

  <!-- 2. What I bring -->
  <section class="section pt-0 md:pt-0" aria-labelledby="bring">
    <h2 id="bring" class="display text-display-sm rule pt-6"><span class="font-mono text-xs text-accent-dim align-middle mr-3" aria-hidden="true">01</span>What I bring to a board</h2>
    <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line border border-line rounded-2xl overflow-hidden">
      {strengths.map((s) => (
        <li class="bg-ink p-6 md:p-7 sm:last:odd:col-span-2 lg:last:odd:col-span-2">
          <h3 class="display text-xl">{s.title}</h3>
          <p class="text-bone-dim leading-relaxed mt-3">{s.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3. Board experience (board seats only) -->
  <section class="section pt-0 md:pt-0" aria-labelledby="board-experience">
    <h2 id="board-experience" class="display text-display-sm rule pt-6"><span class="font-mono text-xs text-accent-dim align-middle mr-3" aria-hidden="true">02</span>Board experience</h2>
    <div class="mt-8 ruled">
      <article class="py-8 grid md:grid-cols-12 gap-x-8 gap-y-4">
        <div class="md:col-span-5">
          <h3 class="display text-display-sm">Milton Community Resource Centre</h3>
          <p class="mt-2 text-bone">Director; Chair, Business Development Committee</p>
          <p class="mt-1 font-mono text-xs uppercase tracking-[0.14em] text-muted">
            <span class="placeholder">[placeholder: start year]</span> – present
          </p>
        </div>
        <ul class="md:col-span-7 space-y-3 text-bone-dim leading-relaxed list-disc pl-5 marker:text-muted">
          <li>I put together the plan, goals and budget for MCRC's upcoming fundraising campaign.</li>
          <li>I cultivate and collect donations, and introduce community and business supporters from my network.</li>
        </ul>
      </article>

      <article class="py-8 grid md:grid-cols-12 gap-x-8 gap-y-4">
        <div class="md:col-span-5">
          <h3 class="display text-display-sm">Peel Standard Condominium Corporation 910</h3>
          <p class="mt-2 text-bone">Director and Treasurer</p>
          <p class="mt-1 font-mono text-xs uppercase tracking-[0.14em] text-muted">
            <time datetime="2015-04">Apr 2015</time> – <time datetime="2019-07">Jul 2019</time>
          </p>
        </div>
        <ul class="md:col-span-7 space-y-3 text-bone-dim leading-relaxed list-disc pl-5 marker:text-muted">
          <li>
            Oversaw a parking garage rebuild. I got the original builder to cover part of the cost, funded the rest
            from the reserve fund, and managed the work on the owners' side.
          </li>
          <li>Oversaw further reserve-funded upgrades: exterior improvements, flooring and interiors, and an LED lighting retrofit.</li>
          <li>Prepared, presented and managed a $2 million operating budget for a community of more than 1,000 residents.</li>
          <li>Negotiated six-figure contracts, saving an average of 11%.</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- 4. Advisory and mentoring (not board seats) -->
  <section class="section pt-0 md:pt-0" aria-labelledby="advisory">
    <h2 id="advisory" class="display text-display-sm rule pt-6"><span class="font-mono text-xs text-accent-dim align-middle mr-3" aria-hidden="true">03</span>Advisory and mentoring</h2>
    <p class="mt-6 text-muted max-w-prose">These are advisory roles, not board seats.</p>
    <ul class="mt-6 ruled">
      {advisory.map((a) => (
        <li class="py-6 grid md:grid-cols-12 gap-x-8 gap-y-2">
          <div class="md:col-span-5">
            <h3 class="display text-xl">{a.org}</h3>
            <p class="mt-1 text-bone">{a.role}</p>
            <p class="mt-1 font-mono text-xs uppercase tracking-[0.14em] text-muted">
              <time datetime={a.dates.fromIso}>{a.dates.from}</time> – present
            </p>
          </div>
          <p class="md:col-span-7 text-bone-dim leading-relaxed">{a.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 5. Community -->
  <section class="section pt-0 md:pt-0" aria-labelledby="community">
    <div class="grid md:grid-cols-12 gap-8 rule pt-6">
      <h2 id="community" class="display text-display-sm md:col-span-5"><span class="font-mono text-xs text-accent-dim align-middle mr-3" aria-hidden="true">04</span>Community</h2>
      <ul class="md:col-span-7 ruled">
        {community.map((c) => (
          <li class="py-4 text-bone-dim leading-relaxed">{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6 and 7. How I work, what I'm looking for -->
  <section class="section pt-0 md:pt-0">
    <div class="grid md:grid-cols-2 gap-px bg-line border border-line rounded-2xl overflow-hidden">
      <div class="bg-ink p-7 md:p-10">
        <h2 id="how-i-work" class="display text-display-sm"><span class="font-mono text-xs text-accent-dim align-middle mr-3" aria-hidden="true">05</span>How I work on a board</h2>
        <p class="mt-5 text-lg text-bone-dim leading-relaxed">
          I try to ask the hard question early, and kindly. Once the board makes its decision, I'm fully behind it.
          On projects, my job is to make sure everyone at the table sees the honest status, not the hopeful one.
        </p>
      </div>
      <div class="bg-ink p-7 md:p-10">
        <h2 id="looking-for" class="display text-display-sm"><span class="font-mono text-xs text-accent-dim align-middle mr-3" aria-hidden="true">06</span>What I'm looking for</h2>
        <p class="mt-5 text-lg text-bone-dim leading-relaxed">
          I'm open to nonprofit and corporate board seats, especially in community services, animal welfare,
          technology, and regulated industries where AI governance matters. I'm based in Milton and serve Halton and
          the GTA. I don't take on anything I can't go all in on, so I'm selective about where I serve.
        </p>
      </div>
    </div>
  </section>

  <!-- 8. Affiliations and interests -->
  <section class="section pt-0 md:pt-0" aria-labelledby="affiliations">
    <div class="grid md:grid-cols-12 gap-8 rule pt-6">
      <div class="md:col-span-5">
        <h2 id="affiliations" class="display text-display-sm"><span class="font-mono text-xs text-accent-dim align-middle mr-3" aria-hidden="true">07</span>Affiliations and interests</h2>
        <p class="mt-5 text-bone-dim leading-relaxed">In the interest of transparency, my current affiliations:</p>
      </div>
      <div class="md:col-span-7">
        <ul class="ruled">
          {affiliations.map((a) => (
            <li class="py-4 leading-relaxed"><span class="text-bone font-medium">{a.name}</span> <span class="text-bone-dim">— {a.what}</span></li>
          ))}
        </ul>
        <p class="mt-6 text-bone-dim leading-relaxed">I declare these to any board I serve on and recuse myself where appropriate.</p>
      </div>
    </div>
  </section>

  <!-- 9. Contact -->
  <section class="page pb-20" aria-labelledby="boards-contact">
    <h2 id="boards-contact" class="sr-only">Contact</h2>
    <p class="rule pt-6 text-lg text-bone-dim leading-relaxed">
      Email me at <a href={`mailto:${email}`} class="link">{email}</a>, or
      <a href={resume} class="link" type="application/pdf">download my board resume (PDF)</a>.
    </p>
  </section>
</Layout>

<style>
  /* A visible, unmistakable "not filled in yet". */
  .placeholder {
    @apply inline-block px-1.5 rounded border border-dashed border-accent-dim text-bone normal-case tracking-normal;
  }
</style>
