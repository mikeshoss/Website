---
import Layout from '../layouts/Layout.astro';
import ProducerTag from '../components/ProducerTag.astro';
import Key from '../components/Key.astro';
import { site, hero, highlights, credits, calls, machineRoom, about, volunteering, interests, causes } from '../data/content';
import { formatDate } from '../lib/dates';

/**
 * Home, in the producer framing: who made this, the credits, the machines
 * behind them, where it is going, and who the person is. Order is the
 * argument — proof before opinion, opinion before personality.
 */

const [beforeEm, afterEm] = hero.headline.split(hero.headlineEmphasis);

// The six credits that carry the most weight; the rest are on /credits.
const selected = credits.slice(0, 6);

// Giving back: boards first, then mentoring — current roles only.
const current = volunteering.filter(v => !v.end);
const givingBack = [
  ...current.filter(v => v.category === 'governance'),
  ...current.filter(v => v.category === 'mentoring'),
];
---

<Layout ogType="profile">
  <!-- ============================================================ Hero -->
  <section class="page pt-14 md:pt-20 pb-16 md:pb-24">
    <!-- Panel markings: the line of small type along the top of a Braun unit. -->
    <div class="flex items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">
      <span>MS–01 · {site.location.split(',')[0]}, Ontario</span>
      <span class="flex items-center gap-2"><span class="led" aria-hidden="true"></span> Building</span>
    </div>

    <div class="mt-12 md:mt-16 grid md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-9">
        <h1 class="display text-display-xl max-w-[16ch]">
          {beforeEm}<em>{hero.headlineEmphasis}</em>{afterEm}
        </h1>
        <p class="lede mt-8 md:mt-10 max-w-prose">{hero.subheadline}</p>
      </div>
      <!-- Speaker grille: the one decorative element on the page. -->
      <div class="hidden md:block md:col-span-3 aspect-square rounded-[1.75rem] grille border border-line" aria-hidden="true"></div>
    </div>

    <!-- On a phone the tag gets its own row, so it never competes with the buttons for width. -->
    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-7 sm:gap-10">
      <div class="flex items-center gap-3">
        <a href="/contact" class="btn-primary">Let's build</a>
        <a href="/credits" class="btn-quiet">The credits</a>
      </div>
      <ProducerTag size="hero" animate />
    </div>

    <!-- Readouts -->
    <dl class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-px bg-line border border-line rounded-2xl overflow-hidden">
      {highlights.map(stat => (
        <div class="bg-ink p-5 md:p-6 flex flex-col-reverse justify-end">
          <dt class="eyebrow mt-3 leading-relaxed">{stat.label}</dt>
          <dd class="readout">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ============================================================ Now -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">01 — Now</p>
    <div class="mt-8 grid md:grid-cols-3 gap-px bg-line border border-line rounded-2xl overflow-hidden">
      {hero.now.map(item => (
        <a href={item.href} class="group bg-ink p-7 md:p-8 transition-colors duration-200 hover:bg-ink-50">
          <p class="eyebrow flex items-center gap-2"><span class="led" aria-hidden="true"></span>{item.label}</p>
          <h2 class="display text-display-md mt-5 group-hover:text-accent transition-colors duration-200">{item.title}</h2>
          <p class="text-sm text-bone-dim mt-1">{item.role}</p>
          <p class="text-sm text-muted leading-relaxed mt-4">{item.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ============================================================ Credits -->
  <section class="section pt-0 md:pt-0">
    <div class="rule pt-6 flex items-baseline justify-between">
      <p class="eyebrow">02 — Selected credits</p>
      <a href="/credits" class="arrow-link text-xs">All credits →</a>
    </div>
    <h2 class="display text-display-lg mt-8 max-w-[20ch]">If my name's on it, it's a <em>hit</em>.</h2>
    <ol class="mt-10 ruled">
      {selected.map(c => (
        <li class="py-5 grid grid-cols-[1fr_auto] md:grid-cols-[minmax(0,4fr)_minmax(0,2fr)_minmax(0,6fr)_auto] gap-x-6 gap-y-1 items-baseline">
          <p class="display text-xl md:text-2xl leading-tight">{c.work}</p>
          <p class="text-xs font-mono uppercase tracking-wider text-muted md:order-none order-last col-span-2 md:col-span-1">{c.label} · <span class="text-accent-dim">{c.credit}</span></p>
          <p class="text-sm text-bone-dim leading-relaxed hidden md:block">{c.result}</p>
          <p class="text-xs font-mono text-muted text-right">{c.year}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================================================ Machine room -->
  <section class="carbon">
    <div class="section">
      <div class="flex items-center justify-between">
        <p class="eyebrow">03 — The machine room</p>
        <span class="flex items-center gap-2 font-mono text-[0.625rem] uppercase tracking-[0.18em] text-carbon-muted"><span class="led" aria-hidden="true"></span> Running</span>
      </div>
      <div class="mt-8 grid md:grid-cols-12 gap-10">
        <div class="md:col-span-5">
          <h2 class="display text-display-lg max-w-[14ch]">I build the machines that build the machine.</h2>
          <p class="mt-6 text-carbon-muted leading-relaxed max-w-prose">
            Shipping fast in high-stakes work isn't heroics. It's infrastructure: agents, pipelines and
            checks that make the right thing the easy thing. Most of mine run in my house.
          </p>
          <div class="mt-10 h-28 rounded-2xl grille-dark hidden md:block" aria-hidden="true"></div>
        </div>
        <ol class="md:col-span-7 border-t border-carbon-line">
          {machineRoom.map((m, i) => (
            <li class="py-5 border-b border-carbon-line grid grid-cols-[2.5rem_1fr] gap-x-4">
              <span class="font-mono text-xs text-accent pt-1">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="text-carbon-text font-medium">{m.name}</p>
                <p class="text-sm text-carbon-muted leading-relaxed mt-1">{m.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============================================================ Calls -->
  <section class="section">
    <p class="eyebrow rule pt-6">04 — Where it's going</p>
    <div class="mt-8 grid md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <h2 class="display text-display-lg max-w-[14ch]">Looking ahead. Building for now.</h2>
        <p class="mt-6 text-muted leading-relaxed text-sm max-w-prose">
          Calls on where business and AI are going, dated when I made them and marked right or wrong
          when the time comes. Opinions are cheap. A record isn't.
        </p>
      </div>
      <ol class="md:col-span-7 ruled">
        {calls.map(c => (
          <li class="py-6">
            <p class="text-lg text-bone leading-snug">{c.call}</p>
            <p class="mt-3 flex items-center gap-4 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-muted">
              <span>Called {formatDate(c.made)}</span>
              <span class="flex items-center gap-1.5">
                <span class={c.status === 'Open' ? 'led-off' : c.status === 'Right' ? 'led' : 'inline-block w-2 h-2 rounded-full bg-accent'} aria-hidden="true"></span>
                {c.status}
              </span>
              {c.draft && <span class="text-accent-dim">Draft · placeholder</span>}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================================================ Who I am -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">05 — Who I am</p>
    <div class="mt-8 grid md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <!-- Photo slot: replace with the portrait when it arrives. -->
        <div class="aspect-[4/5] w-2/3 sm:w-1/2 md:w-full rounded-[1.75rem] bg-ink-50 border border-line grille flex items-end p-5">
          <span class="font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted bg-ink px-2 py-1 rounded">Photo · coming</span>
        </div>
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-5">
        {about.map(paragraph => <p class="text-lg text-bone-dim leading-relaxed">{paragraph}</p>)}

        <div class="pt-6">
          <p class="eyebrow mb-3">Giving back</p>
          <ul class="ruled">
            {givingBack.map(v => (
              <li class="py-3 flex items-baseline justify-between gap-4">
                <span class="text-sm text-bone">{v.organization.replace(/ \(.*\)$/, '')}</span>
                <span class="text-xs text-muted text-right">{v.title.split(' — ')[0].replace(/^Board Member & /, 'Board · ')}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pt-4">
          <a href="/off-the-clock/" class="eyebrow mb-3 inline-block hover:text-bone transition-colors">Off the clock</a>
          <!-- Plain text on purpose: each one is a link, but the line reads as a list, not a menu. -->
          <p class="text-sm text-muted leading-relaxed">
            {interests.map((i, n) => (
              <>{n > 0 && ' · '}<a href={`/off-the-clock/${i.slug}/`} class="hover:text-bone transition-colors">{i.name}</a></>
            ))}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ Where I give -->
  {causes.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">06 — Where I give</p>
      <div class="mt-8 grid md:grid-cols-12 gap-8">
        <h2 class="display text-display-lg md:col-span-5 max-w-[14ch]">Worth more than a mention.</h2>
        <p class="md:col-span-6 md:col-start-7 text-muted leading-relaxed self-end">
          The places I give to. If anything on this site was useful to you, send a little their way.
        </p>
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-px bg-line border border-line rounded-2xl overflow-hidden">
        {causes.map(cause => (
          <div class="bg-ink p-7 md:p-8 flex flex-col">
            <h3 class="display text-display-sm">
              {cause.url
                ? <a href={cause.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{cause.name}</a>
                : cause.name}
            </h3>
            {cause.description && <p class="text-sm text-muted leading-relaxed mt-3">{cause.description}</p>}
            {cause.donate && (
              <div class="mt-auto pt-7">
                <a href={cause.donate} target="_blank" rel="noopener noreferrer" class="btn-quiet">Donate ↗</a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ============================================================ Contact -->
  <section class="section pt-0 md:pt-0">
    <div class="rounded-[1.75rem] border border-line p-8 md:p-12 grid md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-8">
        <div class="flex items-center gap-4">
          <Key class="w-14 h-14" />
          <span class="font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">Press it</span>
        </div>
        <h2 class="display text-display-md sm:text-display-lg mt-8"><span class="block">No decks. No theatre.</span><span class="block">Bring the problem.</span></h2>
        <p class="mt-5 text-muted max-w-prose">If it's real and it's expensive to get wrong, I want to hear about it.</p>
      </div>
      <div class="md:col-span-4 flex flex-col items-start md:items-end gap-4">
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn-primary">Let's build</a>
        <a href={`mailto:${site.email}`} class="link text-sm">{site.email}</a>
      </div>
    </div>
  </section>
</Layout>
