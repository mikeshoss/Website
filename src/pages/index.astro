---
import Layout from '../layouts/Layout.astro';
import { site, hero, highlights, selectedResults, experience, projects } from '../data/content';
import { byAssociation, isActive } from '../lib/projects';
import { placement, withCampaign } from '../lib/links';
import { formatPeriod } from '../lib/dates';

/**
 * The headline gets one word in italic amber. Split around it here so the
 * content module stays plain text for every other consumer.
 */
const [beforeEm, afterEm] = hero.headline.split(hero.headlineEmphasis);

// A short career strip: one row per company, showing the latest title but
// the whole tenure — Firework was three roles over 2 years 8 months, and the
// row should say so rather than show the last role's dates. Order is
// deliberate: it is the story, not the chronology.
const FEATURED_COMPANIES = ['Clio', 'Caseware', 'FacilityOS (formerly iLobby)', 'Firework', 'VerticalScope Inc.'];
const keyRoles = FEATURED_COMPANIES.flatMap(name => {
  const roles = experience.filter(r => r.company === name);
  if (roles.length === 0) return [];
  const latest = roles[0];
  const first = roles[roles.length - 1];
  const ongoing = roles.some(r => !r.end);
  return [{ ...latest, tenure: formatPeriod(first.start, ongoing ? undefined : latest.end) }];
});

// What is being built right now, on my own time. First sentence only: a
// list, not a wall of truncated prose.
const building = byAssociation(projects, 'Personal').filter(isActive).slice(0, 4);
const firstSentence = (text: string) => text.split(/(?<=[.!?])\s/)[0];
---

<Layout ogType="profile">
  <!-- Hero: the statement, who is making it, and one way to respond. -->
  <section class="page pt-20 md:pt-28 pb-16 md:pb-20">
    <h1 class="display text-display-xl max-w-[18ch]">
      {beforeEm}<em>{hero.headlineEmphasis}</em>{afterEm}
    </h1>
    <p class="lede mt-8 md:mt-10 max-w-prose">{hero.subheadline}</p>
    <p class="mt-6 font-mono text-xs text-muted">
      {highlights.map((stat, i) => (
        <>{i > 0 && <span class="mx-2">·</span>}<span class="text-bone">{stat.value}</span> {stat.label.toLowerCase()}</>
      ))}
    </p>
    <a href="/contact" class="btn-primary mt-10">Get in touch</a>
  </section>

  <!-- Now: three things at once. The day job is one of them. -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">Now</p>
    <div class="mt-8 grid md:grid-cols-3 gap-px bg-line border border-line">
      {hero.now.map(item => (
        <a href={item.href} class="group bg-ink p-7 md:p-8 transition-colors duration-200 hover:bg-ink-50">
          <p class="eyebrow">{item.label}</p>
          <h2 class="display text-display-md mt-4 group-hover:text-accent transition-colors duration-200">{item.title}</h2>
          <p class="text-sm text-bone-dim mt-1">{item.role}</p>
          <p class="text-sm text-muted leading-relaxed mt-4">{item.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Point of view -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">Point of view</p>
    <div class="mt-8 grid md:grid-cols-12 gap-8">
      <h2 class="display text-display-lg md:col-span-5 max-w-[14ch]">Why this is a product problem.</h2>
      <div class="md:col-span-6 md:col-start-7 space-y-5 prose-body">
        {hero.thesis.map(paragraph => <p>{paragraph}</p>)}
        <p class="text-muted">{hero.credibility}</p>
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">Selected results</p>
    <ol class="mt-8 ruled">
      {selectedResults.map(result => (
        <li class="grid grid-cols-[6rem_1fr] md:grid-cols-[8rem_2fr_3fr] gap-x-6 gap-y-1 py-5 items-baseline">
          <p class="display text-3xl md:text-4xl text-accent leading-none">{result.value}</p>
          <p class="text-bone">{result.label}</p>
          <p class="text-sm text-muted leading-relaxed col-start-2 md:col-start-3">{result.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Track record -->
  <section class="section pt-0 md:pt-0">
    <div class="rule pt-6 flex items-baseline justify-between">
      <p class="eyebrow">Track record</p>
      <a href="/experience" class="arrow-link text-xs">Full history →</a>
    </div>
    <ol class="mt-8 ruled">
      {keyRoles.map(role => (
        <li class="py-5 grid md:grid-cols-12 gap-x-8 gap-y-1">
          <div class="md:col-span-3">
            <p class="display text-2xl leading-tight">{role.company.replace(/ \(.*\)$/, '')}</p>
            <p class="text-xs font-mono text-muted mt-1">{role.tenure}</p>
          </div>
          <div class="md:col-span-9">
            <p class="text-bone">{role.title}</p>
            {role.highlights[0] && <p class="text-sm text-muted leading-relaxed mt-1 max-w-prose">{role.highlights[0]}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Building -->
  <section class="section pt-0 md:pt-0">
    <div class="rule pt-6 flex items-baseline justify-between">
      <p class="eyebrow">Building, on my own time</p>
      <a href="/projects" class="arrow-link text-xs">All projects →</a>
    </div>
    <ol class="mt-8 ruled">
      {building.map(project => {
        const href = project.url ? withCampaign(project.url, placement('home', project.name)) : project.repo;
        return (
          <li class="py-4 grid grid-cols-[1fr_auto] md:grid-cols-[minmax(0,3fr)_minmax(0,7fr)_auto] gap-x-8 gap-y-1 items-baseline">
            <p class="display text-2xl leading-tight">
              {href ? <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{project.name}</a> : project.name}
            </p>
            <p class="text-sm text-muted hidden md:block truncate">{firstSentence(project.description)}</p>
            <p class="text-xs font-mono text-muted">{project.start.slice(0, 4)}</p>
          </li>
        );
      })}
    </ol>
    <p class="mt-6 text-sm text-muted">
      Epilogue's products live at
      <a href={withCampaign('https://epiloguelabs.com', 'home-building')} target="_blank" rel="noopener noreferrer" class="link">epiloguelabs.com</a>.
    </p>
  </section>

  <!-- Contact -->
  <section class="section pt-0 md:pt-0">
    <p class="eyebrow rule pt-6">Contact</p>
    <div class="mt-8 flex flex-col md:flex-row md:items-baseline md:justify-between gap-6">
      <h2 class="display text-display-md max-w-[24ch]">Working on something where being wrong is expensive?</h2>
      <div class="flex flex-wrap items-center gap-6">
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn-primary">Message me on LinkedIn</a>
        <a href={`mailto:${site.email}`} class="link text-sm">{site.email}</a>
      </div>
    </div>
  </section>
</Layout>
