---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — Mike Shoss" description="The page you're looking for doesn't exist.">
  <section class="section-container pt-28 text-center">
    <h1 class="text-6xl font-bold text-white mb-4">404</h1>
    <p class="text-xl text-muted mb-8">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="inline-block bg-accent hover:bg-accent-dim text-white font-medium px-6 py-3 rounded-lg transition-colors"
    >
      Back to home
    </a>
  </section>
</Layout>
