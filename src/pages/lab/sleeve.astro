---
import Layout from '../../layouts/Layout.astro';
import Sleeve from '../../components/Sleeve.astro';
import { about } from '../../data/content';

/**
 * Preview only: the "Who I am" section with the record sleeve in place of the
 * two photos, so it can be judged on the real site before choosing. Hidden:
 * noindex, out of the sitemap, linked from nowhere. Remove once decided.
 */
---

<Layout title="Lab · Record sleeve — Mike Shoss" description="Preview of the record sleeve photo treatment." noindex>
  <section class="page pt-14 md:pt-20 pb-6">
    <div class="flex items-center justify-between eyebrow">
      <span>Lab · Preview · not linked</span>
      <span class="flex items-center gap-2"><span class="led" aria-hidden="true"></span> Option 2</span>
    </div>
    <p class="lede mt-6 max-w-prose">The record sleeve, in place in "Who I am". Hover to slide the record out, click to flip to the B-side.</p>
  </section>

  <section class="section pt-6 md:pt-10">
    <p class="eyebrow rule pt-6">05 — Who I am</p>
    <div class="mt-8 grid md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <Sleeve class="w-[78%] sm:w-[60%] md:w-[88%]" />
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-5">
        {about.map((paragraph) => <p class="text-lg text-bone-dim leading-relaxed">{paragraph}</p>)}
      </div>
    </div>
  </section>
</Layout>
