---
import Layout from '../layouts/Layout.astro';
import ProducerTag from '../components/ProducerTag.astro';
import { credits, site } from '../data/content';
import { placement, withCampaign } from '../lib/links';

/**
 * The discography. Liner notes rather than a CV: the work is the headline,
 * the company is the label it came out on, and the credit is what Mike did.
 * The full role-by-role history stays on /experience.
 */
const isExternal = (href: string) => href.startsWith('http');
---

<Layout
  title="Credits — Mike Shoss"
  description="What Mike Shoss has produced, founded, built and backed — the work, who it was for, and what it did."
  breadcrumbs={[{ name: 'Credits', href: '/credits' }]}
  schema={[
    {
      '@type': 'ItemList',
      '@id': `${site.url}/credits/#credits`,
      name: 'Credits — Mike Shoss',
      numberOfItems: credits.length,
      itemListElement: credits.map((c, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: { '@type': 'CreativeWork', name: c.work, description: c.result },
      })),
    },
  ]}
>
  <section class="page pt-14 md:pt-20 pb-12 md:pb-16">
    <div class="flex items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">
      <span>Side A · Selected works</span>
      <span>{credits.length} tracks</span>
    </div>
    <h1 class="display text-display-xl mt-12 max-w-[14ch]">Credits.</h1>
    <p class="lede mt-8 max-w-prose">
      Producers are known by what they made, not by their job titles. This is the work: what it
      was, who it was for, what I did on it, and what it did.
    </p>
    <div class="mt-8"><ProducerTag size="hero" animate /></div>
  </section>

  <section class="section pt-0 md:pt-0">
    <div class="hidden md:grid grid-cols-[3rem_minmax(0,4fr)_minmax(0,2fr)_minmax(0,1.3fr)_minmax(0,5fr)_3.5rem] gap-x-6 pb-3 font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">
      <span>No.</span><span>Work</span><span>Label</span><span>Credit</span><span>Result</span><span class="text-right">Year</span>
    </div>
    <ol class="ruled">
      {credits.map((c, i) => {
        const href = c.href && (isExternal(c.href) ? withCampaign(c.href, placement('credit', c.work)) : c.href);
        return (
          <li class="py-6 grid grid-cols-[2.5rem_1fr_auto] md:grid-cols-[3rem_minmax(0,4fr)_minmax(0,2fr)_minmax(0,1.3fr)_minmax(0,5fr)_3.5rem] gap-x-6 gap-y-2 items-baseline">
            <span class="font-mono text-xs text-accent-dim">{String(i + 1).padStart(2, '0')}</span>
            <p class="display text-xl md:text-2xl leading-tight">
              {href
                ? <a href={href} {...(isExternal(c.href!) ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="hover:text-accent transition-colors">{c.work}{isExternal(c.href!) && <span class="text-muted text-base"> ↗</span>}</a>
                : c.work}
            </p>
            <span class="font-mono text-[0.6875rem] uppercase tracking-wider text-muted hidden md:block">{c.label}</span>
            <span class="font-mono text-[0.6875rem] uppercase tracking-wider text-accent-dim hidden md:block">{c.credit}</span>
            <p class="text-sm text-bone-dim leading-relaxed col-start-2 col-span-2 md:col-auto md:col-span-1">
              <span class="md:hidden block mb-1.5 font-mono text-[0.6875rem] uppercase tracking-wider text-muted">{c.label} · <span class="text-accent-dim">{c.credit}</span></span>
              {c.result}
            </p>
            <span class="font-mono text-xs text-muted text-right row-start-1 col-start-3 md:row-auto md:col-auto">{c.year}</span>
          </li>
        );
      })}
    </ol>
    <p class="mt-8 text-sm text-muted">
      The role-by-role history, patents and board work are on <a href="/experience" class="link">Experience</a>.
    </p>
  </section>
</Layout>
