<script>
  document.querySelectorAll<HTMLButtonElement>('.swatch[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-label]');
    const hex = btn.dataset.copy ?? '';
    btn.setAttribute('aria-label', `Copy ${hex}`);
    btn.addEventListener('click', async () => {
      if (!label) return;
      try {
        await navigator.clipboard.writeText(hex.toUpperCase());
        label.textContent = 'Copied';
      } catch {
        label.textContent = hex;
      }
      setTimeout(() => (label.textContent = hex), 1200);
    });
  });
</script>
