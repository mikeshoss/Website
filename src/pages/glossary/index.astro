---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/content';
import { glossary, GLOSSARY_CATEGORIES, type GlossaryCategory } from '../../data/glossary';

const groups = (Object.keys(GLOSSARY_CATEGORIES) as GlossaryCategory[])
  .map(key => ({
    key,
    label: GLOSSARY_CATEGORIES[key],
    terms: glossary.filter(t => t.category === key),
  }))
  .filter(group => group.terms.length > 0);
---

<Layout
  card="glossary"
  title="AI Glossary — Mike Shoss"
  description="Plain definitions of the vocabulary around AI products — agent, harness, RAG, eval, guardrails — and what each one turns out to mean in practice."
  breadcrumbs={[{ name: 'Glossary', href: '/glossary' }]}
  schema={[
    {
      '@type': 'DefinedTermSet',
      '@id': `${site.url}/glossary/#termset`,
      name: 'AI Glossary',
      description:
        'Definitions of the vocabulary around AI products, with what each term means in practice.',
      url: `${site.url}/glossary/`,
      inLanguage: 'en-CA',
      author: { '@id': `${site.url}/#person` },
      hasDefinedTerm: glossary.map(term => ({
        '@type': 'DefinedTerm',
        '@id': `${site.url}/glossary/${term.slug}/#term`,
        name: term.term,
        description: term.short,
        url: `${site.url}/glossary/${term.slug}/`,
        ...(term.aliases?.length ? { alternateName: term.aliases } : {}),
      })),
    },
  ]}
>
  <section class="page pt-14 md:pt-20 pb-12 md:pb-16">
    <div class="flex items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">
      <span>Reference</span>
      <span>{groups.reduce((n, g) => n + g.terms.length, 0)} terms</span>
    </div>
    <h1 class="display text-display-xl mt-12 max-w-[14ch]">Glossary.</h1>
    <p class="lede mt-8 max-w-prose">
      The vocabulary that surrounds AI products, for the person who just heard the word in
      a meeting and would rather not ask. Each term gets two readings: what it means, and
      what it turns out to mean once you have shipped one.
    </p>
  </section>

  {groups.map(group => (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">{group.label} <b>{group.terms.length}</b></p>
      <ol class="mt-6 ruled">
        {group.terms.map(term => (
          <li>
            <a href={`/glossary/${term.slug}`} class="group py-6 grid md:grid-cols-12 gap-x-8 gap-y-2 items-baseline">
              <div class="md:col-span-4">
                <h2 class="display text-display-sm group-hover:text-accent transition-colors duration-200">{term.term}</h2>
                {term.aliases && term.aliases.length > 0 && (
                  <p class="text-xs text-muted font-mono mt-1.5">also: {term.aliases.join(' · ')}</p>
                )}
              </div>
              <p class="md:col-span-7 text-sm text-bone-dim leading-relaxed">{term.short}</p>
              <span class="hidden md:block md:col-span-1 text-right text-muted group-hover:text-accent transition-colors duration-200" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Layout>
