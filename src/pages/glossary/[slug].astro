---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/content';
import { glossary, glossaryBySlug, GLOSSARY_CATEGORIES } from '../../data/glossary';

/**
 * One page per term, from the `slug` on each entry in src/data/glossary.ts.
 * The page title is the term's `question` rather than the term itself, so it
 * matches how the thing is actually searched for.
 */
export function getStaticPaths() {
  return glossary.map(term => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props;
const related = (term.related ?? [])
  .map(slug => glossaryBySlug.get(slug))
  .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);
---

<Layout
  title={`${term.question} — Mike Shoss`}
  description={term.short}
  breadcrumbs={[
    { name: 'Glossary', href: '/glossary' },
    { name: term.term, href: `/glossary/${term.slug}` },
  ]}
  schema={[
    {
      '@type': 'DefinedTerm',
      '@id': `${site.url}/glossary/${term.slug}/#term`,
      name: term.term,
      description: term.short,
      url: `${site.url}/glossary/${term.slug}/`,
      ...(term.aliases?.length ? { alternateName: term.aliases } : {}),
      inDefinedTermSet: {
        '@type': 'DefinedTermSet',
        '@id': `${site.url}/glossary/#termset`,
        name: 'AI Glossary',
        url: `${site.url}/glossary/`,
      },
    },
  ]}
>
  <section class="page pt-14 md:pt-20 pb-12 md:pb-16">
    <div class="flex items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">
      <a href="/glossary" class="hover:text-bone transition-colors">← Glossary</a>
      <span>{GLOSSARY_CATEGORIES[term.category]}</span>
    </div>
    <h1 class="display text-display-xl mt-12 max-w-[16ch]">{term.term}</h1>
    <p class="lede mt-8 max-w-prose">{term.short}</p>
    {term.aliases && term.aliases.length > 0 && (
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="eyebrow mr-1">Also called</span>
        {term.aliases.map(alias => <span class="pill">{alias}</span>)}
      </div>
    )}
  </section>

  <section class="section pt-0 md:pt-0">
    <div class="rule pt-10 grid md:grid-cols-12 gap-8">
      <p class="eyebrow md:col-span-4">What it means</p>
      <div class="md:col-span-7 md:col-start-6 space-y-5">
        {term.means.map(paragraph => <p class="prose-body">{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!--
    The second reading is the point of the page, so it is the one block that
    gets lifted off the ground: the carbon panel.
  -->
  <section class="page">
    <div class="carbon rounded-[1.75rem] p-8 md:p-12 grid md:grid-cols-12 gap-8">
      <p class="eyebrow md:col-span-4 flex items-center gap-2"><span class="led" aria-hidden="true"></span>What it really means</p>
      <div class="md:col-span-7 md:col-start-6 space-y-5">
        {term.reallyMeans.map(paragraph => <p class="text-lg leading-relaxed text-carbon-text">{paragraph}</p>)}
      </div>
    </div>
  </section>

  {term.tell && (
    <section class="section">
      <div class="rule pt-10 grid md:grid-cols-12 gap-8">
        <p class="eyebrow md:col-span-4">How to tell</p>
        <p class="md:col-span-7 md:col-start-6 display text-display-sm leading-snug">{term.tell}</p>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">Related</p>
      <div class="mt-8 grid md:grid-cols-3 gap-px bg-line border border-line rounded-2xl overflow-hidden">
        {related.map(other => (
          <a href={`/glossary/${other.slug}`} class="group bg-ink p-7 transition-colors duration-200 hover:bg-ink-50">
            <h2 class="display text-display-sm group-hover:text-accent transition-colors duration-200">{other.term}</h2>
            <p class="text-sm text-muted leading-relaxed mt-3">{other.short}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
