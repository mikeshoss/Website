---
import Layout from '../../layouts/Layout.astro';
import { companies, site } from '../../data/content';

const names = companies.map((company) => company.name).join(', ');
---

<Layout
  card="companies"
  title="Ventures — Mike Shoss"
  description={`The ventures Mike Shoss founded and runs: ${names}.`}
  breadcrumbs={[{ name: 'Ventures', href: '/companies' }]}
  schema={[
    {
      '@type': 'ItemList',
      '@id': `${site.url}/companies/#ventures`,
      name: 'Ventures founded by Mike Shoss',
      itemListOrder: 'https://schema.org/ItemListUnordered',
      numberOfItems: companies.length,
      itemListElement: companies.map((company, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Organization',
          '@id': `${site.url}/companies/${company.slug}/#organization`,
          name: company.name,
          description: company.tagline,
          url: company.url ?? `${site.url}/companies/${company.slug}/`,
        },
      })),
    },
  ]}
>
  <section class="page pt-14 md:pt-20 pb-12 md:pb-16">
    <div class="flex items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">
      <span>The companies</span>
      <span>{companies.length} ventures</span>
    </div>
    <h1 class="display text-display-xl mt-12 max-w-[14ch]">Ventures.</h1>
    <p class="lede mt-8 max-w-prose">What I've founded and run, and the structure that holds it together.</p>
  </section>

  <section class="section pt-0 md:pt-0">
    <ol class="ruled">
      {companies.map((company, i) => (
        <li>
          <a href={`/companies/${company.slug}`} class="group py-8 md:py-10 grid grid-cols-[2.5rem_1fr] md:grid-cols-[3rem_minmax(0,4fr)_minmax(0,6fr)_auto] gap-x-6 gap-y-3 items-baseline">
            <span class="font-mono text-xs text-accent-dim">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2 class="display text-display-md group-hover:text-accent transition-colors duration-200">{company.name}</h2>
              <p class="text-sm text-bone-dim mt-2">{company.role.split(' — ')[0]}</p>
              <p class="font-mono text-xs text-muted mt-1">{company.period}</p>
            </div>
            <div class="col-start-2 md:col-start-auto">
              <p class="text-bone-dim leading-relaxed">{company.tagline}</p>
              <p class="mt-3 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-muted flex flex-wrap gap-x-4 gap-y-1">
                {company.products?.length ? <span>{company.products.length} products</span> : null}
                {company.clients?.length ? <span>{company.clients.length} clients &amp; partners</span> : null}
                {company.networks?.length ? <span>{company.networks.length} networks &amp; funds</span> : null}
                {company.holdings?.length ? <span>Holds {company.holdings.length}</span> : null}
              </p>
            </div>
            <span class="hidden md:block text-muted group-hover:text-accent transition-colors duration-200" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>
