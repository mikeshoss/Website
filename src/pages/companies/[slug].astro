---
import Layout from '../../layouts/Layout.astro';
import { companies, site } from '../../data/content';
import { withCampaign } from '../../lib/links';

/**
 * One page per venture, from the `slug` on each entry in src/data/content.ts.
 * Adding a venture there adds its page, its card on /companies, its JSON API
 * entry and its sitemap URL — nothing here needs touching.
 */
export function getStaticPaths() {
  return companies.map((company) => ({
    params: { slug: company.slug },
    props: { company },
  }));
}

const { company } = Astro.props;

const organization = {
  '@type': 'Organization',
  '@id': `${site.url}/companies/${company.slug}/#organization`,
  name: company.name,
  description: company.tagline,
  url: company.url ?? `${site.url}/companies/${company.slug}/`,
  ...(company.url ? { sameAs: [company.url] } : {}),
  founder: { '@id': `${site.url}/#person` },
  foundingDate: company.start,
  ...(company.products?.length
    ? {
        makesOffer: company.products.map((product) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'SoftwareApplication',
            name: product.name,
            description: product.description,
            applicationCategory: 'BusinessApplication',
          },
        })),
      }
    : {}),
};
---

<Layout
  title={`${company.name} — Mike Shoss`}
  description={company.tagline}
  breadcrumbs={[
    { name: 'Ventures', href: '/companies' },
    { name: company.name, href: `/companies/${company.slug}` },
  ]}
  schema={[organization]}
>
  <section class="section-container pt-28">
    <a href="/companies" class="text-sm text-muted hover:text-accent transition-colors mb-8 inline-block">
      ← All ventures
    </a>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
      <div>
        <h1 class="text-4xl font-bold tracking-tight mb-2">{company.name}</h1>
        <p class="text-accent">{company.role}</p>
      </div>
      <span class="text-sm text-muted font-mono whitespace-nowrap sm:mt-2">{company.period}</span>
    </div>

    <p class="text-xl text-bone-dim leading-relaxed max-w-3xl mb-6">{company.tagline}</p>

    {company.url && (
      <a
        href={withCampaign(company.url, `venture-${company.slug}`)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary mb-14"
      >
        Visit {company.name}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}

    <!-- Long-form -->
    {company.body && company.body.length > 0 && (
      <div class={`max-w-3xl space-y-5 ${company.url ? '' : 'mt-8'}`}>
        {company.body.map(paragraph => (
          <p class="text-muted leading-relaxed">{paragraph}</p>
        ))}
      </div>
    )}

    <!-- Arms -->
    {company.arms && company.arms.length > 0 && (
      <div class="mt-16 pt-12 border-t border-line">
        <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-2">How it works</h2>
        <p class="text-muted mb-8">Two arms, tightly integrated.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {company.arms.map(arm => (
            <div class="card">
              <h3 class="text-lg font-semibold text-bone mb-2">{arm.name}</h3>
              <p class="text-sm text-muted leading-relaxed mb-5">{arm.description}</p>
              <ul class="space-y-2">
                {arm.services.map(service => (
                  <li class="text-sm text-bone-dim flex items-start gap-2.5">
                    <span class="w-1 h-1 bg-accent flex-shrink-0 mt-2"></span>
                    {service}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Products -->
    {company.products && company.products.length > 0 && (
      <div class="mt-16 pt-12 border-t border-line">
        <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-2">Products</h2>
        <p class="text-muted mb-8">Built in the studio, shipped to real users.</p>
        <div class="space-y-4">
          {company.products.map(product => (
            <article class="card">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-2">
                <div>
                  <h3 class="text-lg font-semibold text-bone">
                    {product.url ? (
                      <a href={product.url} target="_blank" rel="noopener noreferrer" class="link-hover">
                        {product.name} <span class="text-sm">&#8599;</span>
                      </a>
                    ) : (
                      product.name
                    )}
                  </h3>
                  <p class="text-sm text-accent font-mono mt-0.5">{product.tagline}</p>
                </div>
                <span class="chip chip-live self-start">
                  {product.status}
                </span>
              </div>
              <p class="text-sm text-muted leading-relaxed">{product.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    <!-- Networks (investing) -->
    {company.networks && company.networks.length > 0 && (
      <div class="mt-16 pt-12 border-t border-line">
        <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-2">Investing through</h2>
        <p class="text-muted mb-8">Syndicates, angel networks and funds.</p>
        <div class="flex flex-wrap gap-3">
          {company.networks.map(network => (
            <span class="pill">{network}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Clients -->
    {company.clients && company.clients.length > 0 && (
      <div class="mt-16 pt-12 border-t border-line">
        <h2 class="text-sm font-semibold text-accent uppercase tracking-wider mb-2">Clients & partners</h2>
        <p class="text-muted mb-8">Selected engagements.</p>
        <div class="flex flex-wrap gap-3">
          {company.clients.map(client => (
            <span class="pill">{client}</span>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>
