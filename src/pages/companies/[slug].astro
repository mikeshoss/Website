---
import Layout from '../../layouts/Layout.astro';
import { companies, site } from '../../data/content';
import { withCampaign } from '../../lib/links';

/**
 * One page per venture, from the `slug` on each entry in src/data/content.ts.
 * Adding a venture there adds its page, its card on /companies, its JSON API
 * entry and its sitemap URL — nothing here needs touching.
 */
export function getStaticPaths() {
  return companies.map((company) => ({
    params: { slug: company.slug },
    props: { company },
  }));
}

const { company } = Astro.props;

// Ventures this one holds, in the order `holdings` lists them. A slug that
// matches nothing is dropped, and would be the sign of a typo in content.ts.
const held = (company.holdings ?? [])
  .map(slug => companies.find(c => c.slug === slug))
  .filter((c): c is (typeof companies)[number] => c !== undefined);

const organization = {
  '@type': 'Organization',
  '@id': `${site.url}/companies/${company.slug}/#organization`,
  name: company.name,
  description: company.tagline,
  url: company.url ?? `${site.url}/companies/${company.slug}/`,
  ...(company.url ? { sameAs: [company.url] } : {}),
  founder: { '@id': `${site.url}/#person` },
  foundingDate: company.start,
  ...(company.products?.length
    ? {
        makesOffer: company.products.map((product) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'SoftwareApplication',
            name: product.name,
            description: product.description,
            applicationCategory: 'BusinessApplication',
          },
        })),
      }
    : {}),
};
---

<Layout
  card={`companies-${company.slug}`}
  title={`${company.name} — Mike Shoss`}
  description={`${company.tagline} Mike Shoss, ${company.role.split(' — ')[0]}, since ${company.start.slice(0, 4)}.`}
  breadcrumbs={[
    { name: 'Ventures', href: '/companies' },
    { name: company.name, href: `/companies/${company.slug}` },
  ]}
  schema={[organization]}
>
  <section class="page pt-14 md:pt-20 pb-12 md:pb-16">
    <div class="flex items-center justify-between font-mono text-[0.625rem] uppercase tracking-[0.18em] text-muted">
      <a href="/companies" class="hover:text-bone transition-colors">← Ventures</a>
      <span>{company.period}</span>
    </div>
    <h1 class="display text-display-xl mt-12 max-w-[16ch]">{company.name}</h1>
    <p class="mt-4 text-bone-dim">{company.role}</p>
    <p class="lede mt-8 max-w-prose">{company.tagline}</p>

    {company.url && (
      <a
        href={withCampaign(company.url, `venture-${company.slug}`)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary mt-10"
      >
        Visit {company.name} ↗
      </a>
    )}
  </section>

  <!-- Long-form -->
  {company.body && company.body.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <div class="rule pt-10 grid md:grid-cols-12 gap-8">
        <p class="eyebrow md:col-span-4">About</p>
        <div class="md:col-span-7 md:col-start-6 space-y-5">
          {company.body.map(paragraph => <p class="prose-body text-lg">{paragraph}</p>)}
        </div>
      </div>
    </section>
  )}

  <!-- Arms -->
  {company.arms && company.arms.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">How it works · {company.arms.length} arms</p>
      <div class="mt-8 grid md:grid-cols-2 gap-px bg-line border border-line rounded-2xl overflow-hidden">
        {company.arms.map(arm => (
          <div class="bg-ink p-7 md:p-8">
            <h2 class="display text-display-sm">{arm.name}</h2>
            <p class="text-sm text-muted leading-relaxed mt-3">{arm.description}</p>
            <ul class="mt-6 ruled">
              {arm.services.map(service => <li class="py-2.5 text-sm text-bone-dim">{service}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Products -->
  {company.products && company.products.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">Products <b>{company.products.length}</b></p>
      <ol class="mt-6 ruled">
        {company.products.map(product => (
          <li class="py-7 grid md:grid-cols-12 gap-x-8 gap-y-3">
            <div class="md:col-span-4">
              <h2 class="display text-display-sm">
                {product.url ? (
                  <a href={product.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
                    {product.name} <span class="text-muted text-base">↗</span>
                  </a>
                ) : product.name}
              </h2>
              <p class="text-sm text-bone-dim mt-1">{product.tagline}</p>
            </div>
            <p class="md:col-span-6 text-sm text-muted leading-relaxed">{product.description}</p>
            <div class="md:col-span-2 md:text-right">
              <span class="chip">{product.status}</span>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Holdings (holding company) -->
  {held.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">Holds <b>{held.length}</b></p>
      <div class="mt-8 grid md:grid-cols-3 gap-px bg-line border border-line rounded-2xl overflow-hidden">
        {held.map(h => (
          <a href={`/companies/${h.slug}`} class="group bg-ink p-7 transition-colors duration-200 hover:bg-ink-50">
            <p class="display text-display-sm group-hover:text-accent transition-colors duration-200">{h.name}</p>
            <p class="text-sm text-bone-dim mt-1">{h.role.split(' — ')[0]}</p>
            <p class="text-sm text-muted leading-relaxed mt-3">{h.tagline}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Networks (investing) -->
  {company.networks && company.networks.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">Investing through <b>{company.networks.length}</b></p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {company.networks.map(network => <li class="pill">{network}</li>)}
      </ul>
    </section>
  )}

  <!-- Clients -->
  {company.clients && company.clients.length > 0 && (
    <section class="section pt-0 md:pt-0">
      <p class="eyebrow rule pt-6">Clients &amp; partners <b>{company.clients.length}</b></p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {company.clients.map(client => <li class="pill">{client}</li>)}
      </ul>
    </section>
  )}
</Layout>
