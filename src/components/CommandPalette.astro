---
/**
 * The ⌘K command menu: every page, section, venture, term and endpoint, plus
 * actions, on a carbon panel that reads like a calculator display. Open with
 * ⌘K / Ctrl+K, "/", or any [data-cmdk-open] button. The index is
 * /palette.json, fetched on first open.
 *
 * Browse: before anything is typed it is a numbered menu. 1–9 open an item;
 * items with a › open a submenu (Esc, ← or Backspace go back). Typing
 * searches everything instead.
 *
 * Cheat codes: type one exactly and press Enter. They are not listed or
 * searchable; the footer counts how many this browser has found.
 *
 * Accessibility: a native <dialog> (focus is trapped, Esc closes, focus
 * returns), a combobox input driving a listbox via aria-activedescendant,
 * and a live region for result counts and accepted codes.
 */
---

<dialog id="cmdk" class="cmdk" aria-label="Command menu">
  <div class="cmdk-panel carbon">
    <div class="cmdk-head">
      <span class="cmdk-label" id="cmdk-status">MS–01 · Command</span>
      <span class="cmdk-ready"><span class="led" aria-hidden="true"></span> Ready</span>
    </div>
    <div class="cmdk-input-row">
      <span class="cmdk-prompt" aria-hidden="true">›</span>
      <input
        id="cmdk-input"
        type="text"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-describedby="cmdk-help"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="Pick a number, or type anything"
      />
    </div>
    <ul id="cmdk-list" class="cmdk-list" role="listbox" aria-label="Results"></ul>
    <div class="cmdk-foot">
      <span id="cmdk-help" class="cmdk-keys">
        <kbd>1–9</kbd> pick <kbd>↵</kbd> open <kbd>esc</kbd> back
      </span>
      <span id="cmdk-codes" class="cmdk-codes"></span>
    </div>
    <p id="cmdk-live" class="sr-only" aria-live="polite"></p>
  </div>
</dialog>

<style is:global>
  .cmdk {
    padding: 0;
    border: 0;
    background: transparent;
    width: min(640px, calc(100vw - 2rem));
    max-height: min(560px, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    overflow: visible;
  }
  .cmdk::backdrop {
    background: rgb(27 26 24 / 0.45);
    backdrop-filter: blur(3px);
  }
  .cmdk-panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    border-radius: 1.25rem;
    border: 1px solid #3a3732;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.04);
    overflow: hidden;
    /* A faint scanline, like a display behind glass. */
    background-image: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 3px);
  }
  .cmdk[open] .cmdk-panel { animation: cmdk-in 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes cmdk-in { from { opacity: 0; transform: translateY(-6px) scale(0.985); } }

  .cmdk-head, .cmdk-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.1rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8f897e;
  }
  .cmdk-head { border-bottom: 1px solid #3a3732; }
  .cmdk-ready { display: inline-flex; align-items: center; gap: 0.5rem; }
  .cmdk-label.accepted { color: #f0661f; animation: cmdk-flicker 0.5s steps(2, end) 2; }
  @keyframes cmdk-flicker { 50% { opacity: 0.35; } }

  .cmdk-input-row { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.1rem; border-bottom: 1px solid #3a3732; }
  .cmdk-prompt { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 1.25rem; color: #f0661f; line-height: 1; }
  #cmdk-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    color: #e9e5dc;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.0625rem;
    letter-spacing: 0.02em;
    caret-color: #f0661f;
    caret-shape: block;
  }
  #cmdk-input::placeholder { color: #8f897e; }

  .cmdk-list { list-style: none; margin: 0; padding: 0.4rem; overflow-y: auto; flex: 1; overscroll-behavior: contain; }
  .cmdk-group {
    padding: 0.85rem 0.7rem 0.35rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8f897e;
  }
  .cmdk-group b { color: #f0661f; font-weight: 500; margin-right: 0.5rem; }
  .cmdk-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.7rem;
    border-radius: 0.6rem;
    cursor: pointer;
    color: #e9e5dc;
    position: relative;
  }
  .cmdk-item .t { font-size: 0.9375rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cmdk-item .t mark { background: none; color: #f0661f; }
  .cmdk-list ul { list-style: none; margin: 0; padding: 0; }
  .cmdk-item .h {
    flex: none;
    max-width: 45%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    color: #8f897e;
  }
  .cmdk-item[aria-selected='true'] { background: #24221f; }
  .cmdk-item[aria-selected='true']::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 3px;
    border-radius: 2px;
    background: #e0520f;
  }
  .cmdk-num, .cmdk-num-gap {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    margin-right: 0.75rem;
    border-radius: 0.35rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    color: #e9e5dc;
    background: #24221f;
    border: 1px solid #3a3732;
    border-bottom-width: 2px;
    align-self: center;
  }
  .cmdk-num-gap { visibility: hidden; }
  .cmdk-list:not(.numbered) .cmdk-num-gap { display: none; }
  .cmdk-item[aria-selected='true'] .cmdk-num { background: #e0520f; border-color: #b5420b; color: #111110; }
  .cmdk-item .t { flex: 1; min-width: 0; }
  .cmdk-back { cursor: pointer; color: #e9e5dc; margin-right: 0.75rem; }
  .cmdk-back:hover { color: #f0661f; }
  .cmdk-empty { padding: 1.5rem 0.7rem; color: #8f897e; font-size: 0.9375rem; }
  .cmdk-empty b { color: #e9e5dc; font-weight: 500; }

  .cmdk-foot { border-top: 1px solid #3a3732; }
  .cmdk-keys { display: inline-flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
  .cmdk-keys kbd, .cmdk-kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.35rem;
    padding: 0 0.35rem;
    border-radius: 0.35rem;
    background: #24221f;
    border: 1px solid #3a3732;
    border-bottom-width: 2px;
    color: #e9e5dc;
    font: inherit;
    letter-spacing: 0.06em;
  }
  .cmdk-keys kbd:nth-of-type(2), .cmdk-keys kbd:nth-of-type(3) { margin-left: 0.6rem; }
  .cmdk-codes b { color: #f0661f; font-weight: 500; }

  @media (prefers-reduced-motion: reduce) {
    .cmdk[open] .cmdk-panel, .cmdk-label.accepted { animation: none; }
  }
  @media (max-width: 480px) {
    .cmdk { margin-top: 1rem; }
    .cmdk-codes { display: none; }
  }
</style>

<script>
  type Item = { t: string; h?: string; g?: string; u?: string; k?: string; x?: true; a?: 'copy' | 'tag'; v?: string; c?: Item[] };

  // Cheat codes. Unlisted and unsearchable on purpose: you have to know them.
  // Codes start with a letter: digits on an empty prompt are menu shortcuts.
  const CODES: Record<string, { label: string; run: () => void | Promise<void> }> = {
    HIT: { label: 'Now playing', run: () => playTag() },
    FLIP: { label: 'B-side', run: () => { store('ms-flip', '1', sessionStorage); go('/#who-i-am'); } },
    PORYGON: { label: 'Master set', run: () => go('/off-the-clock/cards/#porygon') },
    ONAIR: { label: 'Signal found', run: () => go('/off-the-clock/amateur-radio/') },
    BIGMODEL: { label: '122 billion parameters', run: () => go('/off-the-clock/homelab/#fleet') },
    STUDIO: { label: 'Booking the studio', run: () => open('https://epiloguelabs.com/?utm_source=mikeshoss&utm_medium=referral&utm_content=cheat-code') },
    SUDO: { label: 'Nice try', run: () => go('/contact/') },
    MS01: { label: 'Model number', run: () => go('/brand/#the-mark') },
  };
  const TOTAL = Object.keys(CODES).length;
  const BASE = 'MS–01 · Command';

  const dialog = document.getElementById('cmdk') as HTMLDialogElement | null;
  const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
  const list = document.getElementById('cmdk-list') as HTMLUListElement | null;
  const status = document.getElementById('cmdk-status');
  const live = document.getElementById('cmdk-live');
  const codesEl = document.getElementById('cmdk-codes');

  let items: Item[] = [];
  let menu: Item[] = [];
  let path: Item[] = []; // the submenus opened, root first
  let shown: Item[] = [];
  let active = 0;
  let browsing = true;
  let opener: Element | null = null;

  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  document.querySelectorAll<HTMLElement>('[data-cmdk-key]').forEach((el) => (el.textContent = isMac ? '⌘K' : 'Ctrl K'));

  function read(key: string, area: Storage = localStorage): string | null {
    try { return area.getItem(key); } catch { return null; }
  }
  function store(key: string, value: string, area: Storage = localStorage) {
    try { area.setItem(key, value); } catch { /* private mode: fine */ }
  }
  const found = (): string[] => { try { return JSON.parse(read('ms-codes') || '[]'); } catch { return []; } };
  const recents = (): string[] => { try { return JSON.parse(read('ms-recent') || '[]'); } catch { return []; } };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function go(url: string) {
    dialog?.close();
    if (url === location.pathname + location.hash) return;
    location.href = url;
  }
  function open(url: string) {
    dialog?.close();
    window.open(url, '_blank', 'noopener');
  }
  function playTag() {
    document.querySelector<HTMLElement>('[data-tag-play]')?.click();
  }

  async function load() {
    if (items.length) return;
    try {
      const data = await (await fetch('/palette.json')).json();
      items = data.items;
      menu = data.menu;
    } catch {
      items = [];
      menu = [];
    }
  }

  // Forgiving match on titles: every typed character in order; earlier,
  // word-start and consecutive hits score higher.
  function score(query: string, text: string): number {
    if (!text) return 0;
    const q = query.toLowerCase(), t = text.toLowerCase();
    const at = t.indexOf(q);
    if (at === 0) return 100 - t.length * 0.1;
    if (at > 0) return (/\W/.test(t[at - 1]) ? 80 : 60) - at * 0.5;
    let ti = 0, s = 0, run = 0;
    for (const ch of q) {
      const next = t.indexOf(ch, ti);
      if (next < 0) return 0;
      run = next === ti ? run + 1 : 0;
      s += 2 + run * 3 + (next === 0 || /\W/.test(t[next - 1]) ? 4 : 0);
      ti = next + 1;
    }
    return Math.min(55, s);
  }
  function contains(query: string, text?: string): number {
    if (!text) return 0;
    const at = text.toLowerCase().indexOf(query.toLowerCase());
    return at < 0 ? 0 : at === 0 || /\W/.test(text[at - 1]) ? 80 : 60;
  }
  function highlight(title: string, query: string): string {
    if (!query) return esc(title);
    const at = title.toLowerCase().indexOf(query.toLowerCase());
    if (at < 0) return esc(title);
    return esc(title.slice(0, at)) + '<mark>' + esc(title.slice(at, at + query.length)) + '</mark>' + esc(title.slice(at + query.length));
  }

  function baseStatus() {
    return path.length ? `${BASE} › ${path.map((p) => p.t).join(' › ')}` : BASE;
  }
  function setStatus() {
    if (status && !status.classList.contains('accepted')) status.textContent = baseStatus();
  }

  function option(i: Item, n: number, query: string, num?: number) {
    const key = num ? `<kbd class="cmdk-num" aria-hidden="true">${num}</kbd>` : '<span class="cmdk-num-gap" aria-hidden="true"></span>';
    const hint = i.c ? `${esc(i.h || '')} <span aria-hidden="true">›</span>` : esc(i.h || '');
    const label = i.c ? `${i.t}, submenu` : i.t;
    return `<li class="cmdk-item" role="option" id="cmdk-o${n}" data-i="${n}" aria-selected="${n === active}" aria-label="${esc((num ? num + '. ' : '') + label)}">${key}<span class="t">${highlight(i.t, query)}</span>${hint ? `<span class="h">${hint}</span>` : ''}</li>`;
  }

  function render() {
    if (!list || !input) return;
    const query = input.value.trim();
    browsing = !query;
    let html = '';

    if (browsing) {
      // The numbered menu: the current level, then recent picks at the top level.
      const level = path.length ? path[path.length - 1].c! : menu;
      const rec = path.length ? [] : (recents().map((t) => items.find((i) => i.t === t)).filter(Boolean) as Item[]);
      shown = [...level, ...rec];
      active = Math.min(active, Math.max(0, shown.length - 1));
      const title = path.length ? path[path.length - 1].t : 'Menu';
      html += `<li role="presentation"><div class="cmdk-group" id="cmdk-g1">${path.length ? '<span class="cmdk-back">‹ Back</span>' : '<b>01</b>'}${esc(title)}</div><ul role="group" aria-labelledby="cmdk-g1">`;
      level.forEach((i, n) => (html += option(i, n, '', n < 9 ? n + 1 : undefined)));
      html += '</ul></li>';
      if (rec.length) {
        html += '<li role="presentation"><div class="cmdk-group" id="cmdk-g2"><b>02</b>Recent</div><ul role="group" aria-labelledby="cmdk-g2">';
        rec.forEach((i, n) => (html += option(i, level.length + n, '')));
        html += '</ul></li>';
      }
    } else {
      // Search: flat across everything; loose matching on titles only, hints
      // and keywords must contain the query, so results stay relevant.
      shown = items
        .map((i) => ({ i, s: Math.max(score(query, i.t) * 1.2, contains(query, i.h) * 0.7, contains(query, i.k) * 0.6) }))
        .filter((r) => r.s >= 12)
        .sort((a, b) => b.s - a.s)
        .slice(0, 40)
        .map((r) => r.i);
      const groups = new Map<string, Item[]>();
      for (const i of shown) (groups.get(i.g!) ?? groups.set(i.g!, []).get(i.g!)!).push(i);
      shown = [...groups.values()].flat();
      active = Math.min(active, Math.max(0, shown.length - 1));
      let n = 0, gi = 0;
      for (const [g, group] of groups) {
        gi++;
        html += `<li role="presentation"><div class="cmdk-group" id="cmdk-g${gi}"><b>${String(gi).padStart(2, '0')}</b>${esc(g)}</div><ul role="group" aria-labelledby="cmdk-g${gi}">`;
        for (const i of group) html += option(i, n++, query);
        html += '</ul></li>';
      }
      if (!shown.length) html = `<li class="cmdk-empty" role="presentation">Nothing called <b>${esc(query)}</b>. If it's a code, press enter.</li>`;
    }

    list.innerHTML = html;
    list.classList.toggle('numbered', browsing);
    input.setAttribute('aria-activedescendant', shown.length ? `cmdk-o${active}` : '');
    input.placeholder = path.length ? 'Pick a number, or type to search' : 'Pick a number, or type anything';
    if (live) live.textContent = browsing ? '' : `${shown.length} result${shown.length === 1 ? '' : 's'}`;
    setStatus();
    list.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
  }

  function renderCodes() {
    if (codesEl) codesEl.innerHTML = `Codes <b>${found().length}</b>/${TOTAL}`;
  }

  function into(i: Item) {
    path.push(i);
    active = 0;
    if (input) input.value = '';
    render();
    if (live) live.textContent = `${i.t}: ${i.c!.length} options`;
  }
  function back(): boolean {
    if (!path.length) return false;
    const left = path.pop()!;
    const level = path.length ? path[path.length - 1].c! : menu;
    active = Math.max(0, level.indexOf(left));
    render();
    return true;
  }

  async function run(i: Item | undefined) {
    if (!i) return;
    if (i.c) { into(i); return; }
    store('ms-recent', JSON.stringify([i.t, ...recents().filter((t) => t !== i.t)].slice(0, 4)));
    if (i.a === 'tag') { dialog?.close(); playTag(); return; }
    if (i.a === 'copy' && i.v) {
      try {
        await navigator.clipboard.writeText(i.v);
        flash(`Copied · ${i.t.replace(/^Copy (an |the |my )?/i, '')}`);
      } catch {
        flash('Copy blocked by the browser');
      }
      return;
    }
    if (i.u) i.x ? open(i.u) : go(i.u);
  }

  let flashTimer = 0;
  function flash(text: string, accepted = false) {
    if (!status) return;
    status.textContent = text;
    status.classList.toggle('accepted', accepted);
    if (live) live.textContent = text;
    clearTimeout(flashTimer);
    flashTimer = window.setTimeout(() => {
      status.classList.remove('accepted');
      status.textContent = baseStatus();
    }, 2200);
  }

  function tryCode(raw: string): boolean {
    const code = raw.toUpperCase().replace(/[^A-Z0-9]/g, '');
    const c = CODES[code];
    if (!c) return false;
    const had = found();
    if (!had.includes(code)) store('ms-codes', JSON.stringify([...had, code]));
    renderCodes();
    flash(`Code accepted · ${c.label}`, true);
    if (code !== 'HIT') playTag();
    window.setTimeout(() => c.run(), code === 'HIT' ? 0 : 650);
    return true;
  }

  async function show() {
    if (!dialog || !input) return;
    if (dialog.open) { dialog.close(); return; }
    opener = document.activeElement;
    input.value = '';
    path = [];
    active = 0;
    renderCodes();
    dialog.showModal();
    input.focus();
    await load();
    render();
  }

  dialog?.addEventListener('close', () => {
    if (opener instanceof HTMLElement) opener.focus();
  });
  // Esc in a submenu goes back a level; at the top it closes.
  dialog?.addEventListener('cancel', (e) => {
    if (input?.value) { e.preventDefault(); input.value = ''; render(); }
    else if (back()) e.preventDefault();
  });
  // A click on the dimmed backdrop closes it.
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  input?.addEventListener('input', () => { active = 0; render(); });
  input?.addEventListener('keydown', (e) => {
    const empty = !input.value;
    // Number keys on an empty prompt: open that item straight away.
    if (empty && /^[1-9]$/.test(e.key) && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const level = path.length ? path[path.length - 1].c! : menu;
      const pick = level[+e.key - 1];
      if (pick) { e.preventDefault(); active = +e.key - 1; run(pick); }
      return;
    }
    if (e.key === 'ArrowDown' || (e.ctrlKey && e.key === 'n')) { e.preventDefault(); active = Math.min(shown.length - 1, active + 1); render(); }
    else if (e.key === 'ArrowUp' || (e.ctrlKey && e.key === 'p')) { e.preventDefault(); active = Math.max(0, active - 1); render(); }
    else if (e.key === 'ArrowRight' && empty && shown[active]?.c) { e.preventDefault(); into(shown[active]); }
    else if ((e.key === 'ArrowLeft' || e.key === 'Backspace') && empty && path.length) { e.preventDefault(); back(); }
    else if (e.key === 'Home' && empty) { e.preventDefault(); active = 0; render(); }
    else if (e.key === 'End' && empty) { e.preventDefault(); active = shown.length - 1; render(); }
    else if (e.key === 'Enter') {
      e.preventDefault();
      if (!empty && tryCode(input.value)) return;
      run(shown[active]);
    }
  });
  list?.addEventListener('mousemove', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
    if (li && +li.dataset.i! !== active) { active = +li.dataset.i!; render(); }
  });
  list?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.cmdk-back')) { back(); input?.focus(); return; }
    const li = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
    if (li) { run(shown[+li.dataset.i!]); input?.focus(); }
  });

  document.addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement).tagName) || (e.target as HTMLElement).isContentEditable;
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); show(); }
    else if (e.key === '/' && !typing && !dialog?.open) { e.preventDefault(); show(); }
  });
  document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', () => show()));
</script>
