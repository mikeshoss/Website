---
import { site } from '../data/content';

// The name is the home link, so there is no "Home" entry. Order is the order
// a first-time visitor should read the site in: what I'm building, what I've
// built for myself, where I've worked, then reference and contact.
const links = [
  { label: 'Ventures', href: '/companies' },
  { label: 'Projects', href: '/projects' },
  { label: 'Experience', href: '/experience' },
  { label: 'Glossary', href: '/glossary' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 bg-ink/70 backdrop-blur-md border-b border-line">
  <nav class="page h-16 flex items-center justify-between" aria-label="Main navigation">
    <a href="/" class="font-display text-2xl leading-none text-bone hover:text-accent transition-colors">
      {site.name}
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-7">
      {links.map(link => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          class:list={[
            'font-mono text-[0.6875rem] uppercase tracking-[0.16em] transition-colors duration-200',
            isCurrent(link.href) ? 'text-accent' : 'text-muted hover:text-bone',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile toggle -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-muted hover:text-bone p-2 -mr-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-width="1.5" d="M3 7h18M3 17h18" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden md:hidden border-t border-line bg-ink/95 backdrop-blur-md" aria-label="Mobile navigation">
    <div class="page py-2 ruled">
      {links.map(link => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          class:list={[
            'block py-4 font-display text-2xl transition-colors',
            isCurrent(link.href) ? 'text-accent' : 'text-bone',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
