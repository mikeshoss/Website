---
/**
 * The mark: M in the ring (the logo) or ℗, the phonogram (the producer tag) — the circled P printed on every record, meaning
 * "produced by" — with an orange cursor beside it, meaning the machine is live.
 *
 * `animate` draws it in (ring, then P) — used on the hero tag only. Everywhere
 * else it is simply there. The draw uses explicit path lengths rather than
 * `pathLength`, which Safari has handled inconsistently on basic shapes.
 *
 * `cursor={false}` drops the cursor, for places where a typed line carries its
 * own (ProducerTag). `still` stops the cursor blinking (the footer: one
 * blinking cursor per screen is enough).
 */
interface Props {
  class?: string;
  /** Draw in the carbon palette, for dark surfaces. */
  dark?: boolean;
  cursor?: boolean;
  animate?: boolean;
  still?: boolean;
  /**
   * `m` (default) is the logo: M in the ring, Mike's initial in the circle
   * record labels use. `p` is the ℗ phonogram, kept for the producer tag line
   * ("Produced by Mike Shoss"), where "produced by" is what it means.
   */
  glyph?: 'm' | 'p';
}
const { class: className = 'h-6', dark = false, cursor = true, animate = false, still = false, glyph = 'm' } = Astro.props;
const ink = dark ? '#e9e5dc' : '#1b1a18';
---

<svg
  class:list={['tag-mark w-auto shrink-0', animate && 'tag-draw', className]}
  viewBox={cursor ? '0 0 44 32' : '0 0 32 32'}
  aria-hidden="true"
>
  <circle class="tag-ring" cx="16" cy="16" r="13" fill="none" stroke={ink} stroke-width="2.2" transform="rotate(-90 16 16)" />
  {glyph === 'm'
    ? <path class="tag-m" d="M10.4 22.2V9.8L16 17.2l5.6-7.4v12.4" fill="none" stroke={ink} stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" />
    : <path class="tag-p" d="M12.5 23V9h5a4.2 4.2 0 010 8.4h-5" fill="none" stroke={ink} stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" />}
  {cursor && <rect class:list={['tag-cursor', still && 'tag-still']} x="34" y="7" width="4" height="18" fill="#e0520f" />}
</svg>
