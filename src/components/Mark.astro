---
/**
 * The mark: ℗, the phonogram — the circled P printed on every record, meaning
 * "produced by" — with an orange cursor beside it, meaning the machine is live.
 *
 * It moves: the ring draws itself, then the P, then the cursor starts to
 * blink. All of it is CSS (see "Producer tag" in global.css) and all of it
 * stops under prefers-reduced-motion. `cursor={false}` drops the cursor, for
 * places where a typed line carries its own (see ProducerTag).
 */
interface Props {
  class?: string;
  /** Draw in the carbon palette, for dark surfaces. */
  dark?: boolean;
  cursor?: boolean;
}
const { class: className = 'h-6', dark = false, cursor = true } = Astro.props;
const ink = dark ? '#e9e5dc' : '#1b1a18';
---

<svg class:list={['tag-mark w-auto', className]} viewBox={cursor ? '0 0 44 32' : '0 0 32 32'} aria-hidden="true">
  <circle class="tag-ring" cx="16" cy="16" r="13" fill="none" stroke={ink} stroke-width="2.2" pathLength="1" transform="rotate(-90 16 16)" />
  <path class="tag-p" d="M12.5 23V9h5a4.2 4.2 0 010 8.4h-5" fill="none" stroke={ink} stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" pathLength="1" />
  {cursor && <rect class="tag-cursor" x="34" y="7" width="4" height="18" fill="#e0520f" />}
</svg>
