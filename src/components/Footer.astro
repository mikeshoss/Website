---
import { site } from '../data/content';
import { withCampaign } from '../lib/links';
const year = new Date().getFullYear();

// The page links are in the header on every page; the footer carries only
// what the header does not.
const links = [
  { label: 'LinkedIn', href: site.linkedin, external: true },
  { label: 'GitHub', href: site.github, external: true },
  { label: 'Epilogue', href: withCampaign('https://epiloguelabs.com', 'footer'), external: true },
  { label: 'API', href: '/api/index.json' },
  { label: 'llms.txt', href: '/llms.txt' },
  { label: 'MCP', href: '/mcp' },
];
---

<footer class="border-t border-line mt-16">
  <div class="page py-8 flex flex-col sm:flex-row sm:items-baseline justify-between gap-4">
    <p class="text-xs font-mono text-muted">&copy; {year} {site.name} &nbsp;·&nbsp; {site.location}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="text-xs font-mono link-quiet"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
