---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { companies, education, experience, site, skills } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  /** Overrides the derived canonical. Only needed when a page duplicates another. */
  canonical?: string;
  /** Open Graph object type. The home page is a profile; everything else a website. */
  ogType?: 'website' | 'profile' | 'article';
  /**
   * Trail from the site root to this page, excluding Home (added here). Emitted
   * as a BreadcrumbList, which is what Google renders in place of the raw URL.
   */
  breadcrumbs?: { name: string; href: string }[];
  /** Extra JSON-LD nodes merged into this page's @graph (e.g. an Organization). */
  schema?: Record<string, unknown>[];
}

const {
  title = `${site.name} — ${site.title}`,
  description = site.description,
  canonical,
  ogType = 'website',
  breadcrumbs = [],
  schema = [],
} = Astro.props;

/**
 * Canonical URLs are built from the configured site origin, not from Astro.url,
 * which carries the host the page was built on. Every push to a non-production
 * branch gets a Cloudflare preview deployment, and those are production builds
 * — so deriving the canonical from the request would publish
 * `<preview>.workers.dev` as the canonical of every page and hand Google a
 * competing copy of the site.
 *
 * Trailing slashes are stripped so /companies and /companies/ cannot be indexed
 * as two distinct URLs.
 */
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = canonical ?? new URL(pathname, site.url).href;

const ogImage = `${site.url}/og-image.png`;
const ogImageAlt = `${site.name} — ${site.title}`;

// Google Analytics. The site's only third-party request — everything else,
// fonts included, is self-hosted. Held in one place because Google's snippet
// repeats the measurement ID, which invites drift.
//
// Two guards, covering different things. `import.meta.env.PROD` keeps the code
// out of dev output entirely. The hostname check keeps Cloudflare branch
// previews out of the data — they are production builds, so the PROD gate does
// not exclude them. www needs no entry: www-to-apex is handled by a Cloudflare
// Redirect Rule (see public/_redirects), so visitors land on the apex.
const GA_MEASUREMENT_ID = 'G-3KTD28G14B';
const GA_HOSTNAME = 'mikeshoss.com';

const [city, region] = site.location.split(',').map((part) => part.trim());

// Ongoing employers plus the ventures, deduplicated by name. URLs come from
// whichever record carries one.
const orgUrls = new Map<string, string>();
for (const entry of [...companies, ...experience]) {
  const name = 'company' in entry ? entry.company : entry.name;
  if (entry.url) orgUrls.set(name, entry.url);
}

const orgNames = [
  ...new Set([
    ...experience.filter((role) => !role.end).map((role) => role.company),
    ...companies.map((company) => company.name),
  ]),
];

/**
 * Structured data is emitted as one @graph of cross-referenced nodes rather
 * than as loose objects: the Person is declared once, at a stable @id, and
 * every page points at that node instead of restating it. Search engines then
 * read the whole site as describing a single entity.
 *
 * Every node derives from src/data/content.ts, so the structured data cannot
 * drift away from what the pages actually say.
 */
const personId = `${site.url}/#person`;
const websiteId = `${site.url}/#website`;
const pageId = `${canonicalUrl}#webpage`;

const person = {
  '@type': 'Person',
  '@id': personId,
  name: site.name,
  url: site.url,
  // A deliberate label, rather than the current role's formal title.
  jobTitle: 'Founder & Product Executive',
  description: site.description,
  image: ogImage,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: city,
    addressRegion: region,
    addressCountry: 'CA',
  },
  sameAs: [
    site.linkedin,
    site.github,
    ...companies.flatMap((company) => (company.url ? [company.url] : [])),
  ],
  knowsAbout: skills,
  worksFor: orgNames.map((name) => ({
    '@type': 'Organization',
    name,
    ...(orgUrls.has(name) ? { url: orgUrls.get(name) } : {}),
  })),
  alumniOf: education.map((entry) => ({
    '@type': 'EducationalOrganization',
    name: entry.institution,
  })),
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: site.url,
  name: site.name,
  description: site.description,
  inLanguage: 'en-CA',
  publisher: { '@id': personId },
};

// ProfilePage on the home page states that the page *is* the person, which is
// what qualifies it for an entity panel. Subpages are ordinary WebPages about
// that same person.
const page = {
  '@type': ogType === 'profile' ? 'ProfilePage' : 'WebPage',
  '@id': pageId,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: 'en-CA',
  isPartOf: { '@id': websiteId },
  about: { '@id': personId },
  ...(ogType === 'profile' ? { mainEntity: { '@id': personId } } : {}),
  primaryImageOfPage: ogImage,
};

const breadcrumbList = breadcrumbs.length
  ? [
      {
        '@type': 'BreadcrumbList',
        '@id': `${canonicalUrl}#breadcrumbs`,
        itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map(
          (crumb, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: crumb.name,
            item: new URL(crumb.href, site.url).href,
          }),
        ),
      },
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, page, ...breadcrumbList, ...schema],
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!--
      max-image-preview:large is what lets Google use the full-size card in
      results and in Discover; without it the thumbnail is capped to a postage
      stamp.
    -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!--
      Open Graph. og:image is a PNG deliberately: LinkedIn, X, Facebook, Slack
      and iMessage all ignore an SVG here and fall back to a blank card. The
      dimensions let a scraper lay the card out before the image finishes
      downloading, and must match what scripts/generate-og-image.mjs renders.
    -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content="Mike" />
        <meta property="profile:last_name" content="Shoss" />
        <meta property="profile:username" content="mikeshoss" />
      </>
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts loaded via @fontsource (self-hosted, no external requests) -->

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics -->
    {import.meta.env.PROD && (
      <script
        is:inline
        set:html={`(function () {
  if (location.hostname !== '${GA_HOSTNAME}') return;
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { window.dataLayer.push(arguments); };
  gtag('js', new Date());
  gtag('config', '${GA_MEASUREMENT_ID}');
  var s = document.createElement('script');
  s.async = true;
  s.src = 'https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}';
  document.head.appendChild(s);
})();`}
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.animate-on-scroll').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
