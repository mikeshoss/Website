---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = `${site.name} — ${site.title}`,
  description = site.description,
  canonical = Astro.url.href,
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  jobTitle: "Founder & Product Executive",
  description: site.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Toronto",
    addressRegion: "Ontario",
    addressCountry: "CA",
  },
  sameAs: [
    site.linkedin,
    site.github,
    "https://epiloguelabs.com",
  ],
  knowsAbout: [
    "Artificial Intelligence",
    "Product Management",
    "Multi-Agent Systems",
    "AI Orchestration",
    "Venture Building",
    "Enterprise AI",
    "Local-First Infrastructure",
  ],
  worksFor: [
    {
      "@type": "Organization",
      name: "Epilogue",
      url: "https://epiloguelabs.com",
    },
    {
      "@type": "Organization",
      name: "ShossX",
    },
    {
      "@type": "Organization",
      name: "Caseware",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content="Mike Shoss, AI, product executive, founder, Epilogue, ShossX, multi-agent systems, AI orchestration, venture building, Toronto" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
